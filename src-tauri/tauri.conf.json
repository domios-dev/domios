{
  "$schema": "https://raw.githubusercontent.com/nicegui-dart/tauri/HEAD/core/tauri-config-schema/schema.json",
  "productName": "CodeTerm",
  "version": "1.9.3",
  "identifier": "com.codeterm.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "node scripts/dev-prep.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CodeTerm",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "app", "deb", "appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist": "dist",
      "../skills": "skills",
      "bundled-cli/*": "cli/",
      "conpty/x64/*": "conpty/x64/",
      "conpty/arm64/*": "conpty/arm64/"
    },
    "externalBin": [
      "bundled-embed/codeterm-embed"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwQzA2RDNCMDQ0REVGREUKUldUZTcwMEVPMjNBa0NjMmNVbWdUd3piWksvT1N0Wi9FQmx5OXRrVmZXNlF4VzZiQlFLM2MvTmcK",
      "endpoints": [
        "https://github.com/rollacode/codeterm-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
