{
  "$schema": "https://raw.githubusercontent.com/nicegui-dart/tauri/HEAD/core/tauri-config-schema/schema.json",
  "productName": "Domios",
  "mainBinaryName": "domios-app",
  "version": "1.17.3",
  "identifier": "com.domios.app",
  "build": {
    "frontendDist": "../target/domios-package/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "node scripts/dev-prep.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "create": false,
        "title": "Domios",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (c) 2025 Andrey Kovalev",
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "deb",
      "appimage",
      "rpm"
    ],
    "icon": [
      "icons/app-32x32.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/domios-package/server-component.json": "server-component.json",
      "../target/domios-package/cli/": "cli",
      "../target/domios-package/dist/": "dist",
      "../target/domios-package/skills/": "skills",
      "../target/domios-package/LICENSE": "LICENSE",
      "../target/domios-package/NOTICE": "NOTICE"
    },
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwQzA2RDNCMDQ0REVGREUKUldUZTcwMEVPMjNBa0NjMmNVbWdUd3piWksvT1N0Wi9FQmx5OXRrVmZXNlF4VzZiQlFLM2MvTmcK",
      "endpoints": [
        "https://github.com/domios-dev/domios/releases/latest/download/domios-latest.json",
        "https://github.com/rollacode/codeterm-releases/releases/latest/download/domios-latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "domios"
        ]
      }
    }
  }
}
