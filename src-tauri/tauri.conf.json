{
  "$schema": "https://raw.githubusercontent.com/nicegui-dart/tauri/HEAD/core/tauri-config-schema/schema.json",
  "productName": "CodeTerm",
  "version": "1.0.1",
  "identifier": "com.codeterm.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "touch cli/src/main.rs && cargo build --release --manifest-path cli/Cargo.toml && node scripts/bundle-cli.js && cargo build --release --manifest-path src-tauri/Cargo.toml --bin codeterm-embed && node scripts/bundle-embed.js && pnpm dev",
    "beforeBuildCommand": "pnpm build && touch cli/src/main.rs && cargo build --release --manifest-path cli/Cargo.toml && node scripts/bundle-cli.js && cargo build --release --manifest-path src-tauri/Cargo.toml --bin codeterm-embed && node scripts/bundle-embed.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CodeTerm",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "deb", "appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../skills": "skills",
      "bundled-cli/*": "cli/"
    },
    "externalBin": [
      "bundled-embed/codeterm-embed"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwQzA2RDNCMDQ0REVGREUKUldUZTcwMEVPMjNBa0NjMmNVbWdUd3piWksvT1N0Wi9FQmx5OXRrVmZXNlF4VzZiQlFLM2MvTmcK",
      "endpoints": [
        "https://github.com/rollacode/codeterm/releases/latest/download/latest.json"
      ]
    }
  }
}
