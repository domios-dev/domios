    {"name": "balance reads a required secret", "valid": true,
     "profile": {"binary": "fixture-agent", "args": [], "secretEnv": {"FIXTURE_KEY": "domios:provider:fixture:key"}, "limitsSource": {"kind": "balance", "reader": "fixture-balance", "credentialEnv": "FIXTURE_KEY"}}},
    {"name": "balance reads an optional sign-in secret", "valid": true,
