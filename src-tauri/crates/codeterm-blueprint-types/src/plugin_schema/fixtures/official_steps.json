  {
    "source": "official-schema-1",
    "schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 2048,
          "description": "http(s) page to read; a bound url input wins."
        },
        "wait_text": {
          "type": "string",
          "maxLength": 256,
          "description": "Text to wait for before reading."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000,
          "default": 200,
          "description": "Lines of page text to keep."
        }
      }
    }
  },
