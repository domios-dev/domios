{
  "identifier": "com.domios.dev",
  "productName": "Domios Dev",
  "mainBinaryName": "domios-dev",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "node scripts/dev-prep.mjs --no-server"
  },
  "bundle": {
    "resources": [],
    "externalBin": []
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "create": false,
        "title": "Domios Dev",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --remote-debugging-port=9223"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": []
      }
    }
  }
}
