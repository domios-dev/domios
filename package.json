    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^25.9.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.10.2",
    "knip": "^6.29.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "dependencies": {
    "@codeterm/chat-core": "workspace:*",
    "@codeterm/chat-ui": "workspace:*",
    "@codeterm/provider-claude": "workspace:*",
    "@codeterm/provider-codex": "workspace:*",
    "@codeterm/provider-opencode": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@git-diff-view/react": "^0.1.5",
