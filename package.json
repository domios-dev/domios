{
  "name": "codeterm",
  "version": "1.11.10",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "task": "node scripts/task.mjs",
    "task:cli": "node scripts/task.mjs cli",
    "task:check": "node scripts/task.mjs check",
    "task:sizes": "node scripts/task.mjs sizes",
    "task:test-cli": "node scripts/task.mjs test-cli",
    "build": "node node_modules/typescript/bin/tsc && node node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:unit": "node scripts/run-ts-unit-tests.mjs",
    "test:vitest": "vitest run",
    "test:plugins": "node scripts/run-plugin-tests.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "build:plugin-ui": "node scripts/build-plugin-ui.mjs",
    "check:plugin-bundles": "node scripts/check-plugin-bundles.mjs",
    "test:pw": "playwright test -c tests/playwright",
    "test:pw:smoke": "playwright test -c tests/playwright --project=smoke",
    "test:pw:golden": "playwright test -c tests/playwright --project=golden",
    "test:pw:perf": "playwright test -c tests/playwright --project=perf",
    "test:pw:stub": "playwright test -c tests/playwright --project=stub",
    "test:pw:live-pair": "playwright test -c tests/playwright --project=live tests/playwright/suites/20-new-session/picker-live.spec.ts --timeout=30000 --global-timeout=600000 --reporter=line",
    "test:pw:instance": "tsx scripts/start-playwright-instance.ts",
    "test:pw:one": "tsx scripts/run-playwright-isolated.ts",
    "test:pw:bounded": "tsx scripts/run-playwright-bounded.ts",
    "test:pw:selection": "tsx scripts/run-playwright-selection.ts",
    "test:pw:visual:regen": "bash scripts/regenerate-visual-goldens.sh",
    "test:pw:full": "playwright test -c tests/playwright --project=full",
    "test:pw:lint": "node scripts/check-playwright-spec-headers.mjs && node scripts/playwright-coverage-map.mjs --check && node tests/playwright/helpers/check-tags.mjs",
    "test:pw:report": "playwright show-report tests/playwright/artifacts/html-report",
    "test:pw:trace": "playwright show-trace",
    "test:pw:debug": "playwright test -c tests/playwright --debug",
    "test:pw:audit": "node tests/playwright/helpers/audit-combine.mjs",
    "test:manager-bootstrap": "node evals/manager-bootstrap/live-smoke.mjs",
    "test:provider-matrix": "node evals/manager-bootstrap/provider-matrix.mjs",
    "test:general-agent-provider": "node evals/general-agent/provider-matrix.mjs",
    "check:unused-exports": "knip --workspace @codeterm/chat-core --exports",
    "test:unused-exports-gate": "node scripts/test-unused-exports-gate.mjs",
    "lint": "biome check .",
    "sync:versions": "node scripts/sync-plugin-versions.mjs",
    "check:versions": "node scripts/sync-plugin-versions.mjs --check",
    "check:release-locks": "node scripts/check-release-locks.mjs",
    "sync:plugin-versions": "node scripts/sync-plugin-versions.mjs",
    "check:plugin-versions": "node scripts/sync-plugin-versions.mjs --check",
    "check:api-effects": "node scripts/check-api-effect-dependencies.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
