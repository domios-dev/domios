{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@domios/plugin-sdk": ["./packages/plugin-sdk/src/index.ts"],
      "@codeterm/chat-core": ["packages/chat-core/src/index.ts"], // rename-bridge
      "@codeterm/chat-ui": ["packages/chat-ui/src/index.ts"], // rename-bridge
      "@codeterm/chat-ui/dsTasksBlock": ["packages/chat-ui/src/codeterm/dsTasksBlock.ts"], // rename-bridge
      "@codeterm/chat-ui/renderability": ["packages/chat-ui/src/renderability.ts"], // rename-bridge
      "@codeterm/plugin-sdk": ["packages/plugin-sdk/src/index.ts"] // rename-bridge
    }
  },
  "include": [
    "src",
    "packages/chat-ui/src",
    "packages/plugin-sdk/src",
    "plugins/provider-claude/src/plugin.ts",
    "plugins/provider-codex/src/plugin.ts",
    "plugins/provider-opencode/src/plugin.ts",
    "plugins/provider-cursor/src/plugin.ts",
    "plugins/analytics/src",
    "plugins/analytics/ui/src",
    "plugins/analytics/tests",
    "plugins/browser/src",
    "plugins/browser/tests"
  ],
  "exclude": [
    "packages/chat-ui/src/**/*.test.ts",
    "packages/chat-ui/src/**/*.test.tsx",
    "packages/chat-ui/src/**/*.testdata.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
