# Baked Linux arm64 builder for Domios (native aarch64 on an arm64 Docker host).
# Heavy apt/toolchain lives in image layers -> per-build start is instant; builds
# themselves stay clean (fresh git clone of the tag, no cargo target cache).
#
#   docker build -t codeterm-build-linux-arm64 -f Dockerfile.linux-arm64 .
#
FROM rust:1-trixie
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y -qq \
      libwebkit2gtk-4.1-dev build-essential curl wget file \
      libxdo-dev libssl-dev libayatana-appindicator3-dev librsvg2-dev \
      libgtk-3-dev pkg-config git xdg-utils \
 && rm -rf /var/lib/apt/lists/*
# Debian's sccache is built without S3 and silently falls back to local disk; use the pinned upstream build.
ARG SCCACHE_VERSION=v0.16.0
ARG SCCACHE_SHA256=f73a5c39f96bb6ebb89cc7915cf182260d4cbf30765322c5e793d0fe8bd80784
RUN curl -fsSL -o /tmp/sccache.tar.gz \
      "https://github.com/mozilla/sccache/releases/download/${SCCACHE_VERSION}/sccache-${SCCACHE_VERSION}-aarch64-unknown-linux-musl.tar.gz" \
 && echo "${SCCACHE_SHA256}  /tmp/sccache.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/sccache.tar.gz -C /tmp \
 && install -m 0755 "/tmp/sccache-${SCCACHE_VERSION}-aarch64-unknown-linux-musl/sccache" /usr/local/bin/sccache \
 && rm -rf /tmp/sccache*
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y nodejs && corepack enable
# Pin the repo toolchain so rust-toolchain.toml never triggers a re-download mid-build.
RUN rustup toolchain install 1.95.0 --profile minimal && rustup default 1.95.0
# AppImage tools need FUSE-less extraction inside containers; jobs/debug tuned for 20GiB Docker.
ENV APPIMAGE_EXTRACT_AND_RUN=1 \
    CARGO_PROFILE_RELEASE_DEBUG=0 \
    CARGO_BUILD_JOBS=2 \
    RUSTUP_TOOLCHAIN=1.95.0
