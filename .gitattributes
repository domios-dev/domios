*.sh text eol=lf
essences/CLI.md text eol=lf
essences/cli-manifest.json text eol=lf

.codeterm/plans/**/strides.jsonl merge=union

# Tab-state classifier fixtures match structural patterns on \n boundaries.
# Force LF so checkouts are deterministic across OS (a stray CRLF would skew
# the golden expectations on Windows). CRLF-robustness itself is covered by the
# classify-tab-state CRLF regression tests, which synthesize \r\n at runtime.
plugins/**/tests/fixtures/tab-state/*.txt text eol=lf

# Legacy plan-state converter fixtures assert byte-exact \n structure
# preservation; force LF so the golden expectations hold on Windows checkouts.
tests/fixtures/plan-state/*.yaml text eol=lf

# Cargo rewrites manifests with LF, and core.autocrlf converts them back on every
# checkout — so a plain `cargo` run left Cargo.toml permanently "modified" and
# failed the release provenance check on a dirty tree.
**/Cargo.toml text eol=lf
**/Cargo.lock text eol=lf
