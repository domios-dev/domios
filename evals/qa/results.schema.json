{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curated QA run results",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_stamp", "results"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_stamp": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "NOT RUN", "BLOCKED", "OWNER-SKIPPED"]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "platform",
        "surface",
        "build_sha",
        "boot_id",
        "verdict",
        "started_utc",
        "finished_utc",
        "evidence",
        "notes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^CUR-[0-9]{3}$" },
        "platform": { "type": "string", "minLength": 1 },
        "surface": {
          "type": "string",
          "enum": ["cli", "web", "native", "phone", "mesh", "team"]
        },
        "build_sha": { "type": "string", "minLength": 1 },
        "boot_id": { "type": "string", "minLength": 1 },
        "verdict": { "$ref": "#/$defs/verdict" },
        "started_utc": { "type": "string", "format": "date-time" },
        "finished_utc": { "type": "string", "format": "date-time" },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
