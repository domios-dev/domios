[11.239947834,"o","\u001b[?2026h\u001b[1;35r\u001b[35;1H\r\n\u001b[39;49m\u001b[K  Pipes also influenced Unix culture. Tools such as \u001b[38;5;6;49mgrep\u001b[39;49m, \u001b[38;5;6;49msed\u001b[39;49m, \u001b[38;5;6;49mawk\u001b[39;49m, \u001b[38;5;6;49msort\u001b[39;49m, \u001b[38;5;6;49muniq\u001b[39;49m, \u001b[38;5;6;49mtr\u001b[39;49m, and \u001b[38;5;6;49mwc\u001b[39;49m became powerful partly\u001b[39m\u001b[49m\u001b[0m\u001b[r\u001b[38;3H\u001b[36;2H\u001b[0m\u001b[49m\u001b[K\u001b[37;2H\u001b[0m\u001b[49m\u001b[K\u001b[38;36H\u001b[0m\u001b[49m\u001b[K\u001b[39;2H\u001b[0m\u001b[49m\u001b[K\u001b[40;44H\u001b[0m\u001b[49m\u001b[K\u001b[39m\u001b[49m\u001b[0m\u001b[0 q\u001b[?25h\u001b[38;3H\u001b[?2026l"]
[11.246537209,"o","\u001b[?2026h\u001b[1;35r\u001b[35;1H\r\n"]
[11.25229,"o","\u001b[39;49m\u001b[K  because they could be chained together. Each tool was useful alone, but far more useful in combination. A pipeline\u001b[39m\u001b[49m\u001b[0m\u001b[r\u001b[38;3H\u001b[36;2H\u001b[0m\u001b[49m\u001b[K\u001b[37;2H\u001b[0m\u001b[49m\u001b[K\u001b[38;36H\u001b[0m\u001b[49m\u001b[K\u001b[39;2H\u001b[0m\u001b[49m\u001b[K\u001b[40;44H\u001b[0m\u001b[49m\u001b[K\u001b[39m\u001b[49m\u001b[0m\u001b[0 q\u001b[?25h\u001b[38;3H\u001b[?2026l"]
