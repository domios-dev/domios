[329.94998175,"o","─────────────────────────────────────────────────────────────────────┤\u001b[22m\r\n  \u001b[2m│ \u001b[22mFairness     \u001b[2m │ \u001b[22mOS scheduler; lock-free core doesn't guarantee FIFO under blocking                            \u001b[2m │\u001b[22m\r\n  \u001b[2m└───────────────┴────────────────────────────────────────────────────────────────────────────────────────────────┘\u001b[22m\r\n\r\n  \u001b[1mInvariant:\u001b[22m always \u001b[38;2;168;181;230mtry_*\u001b[39m first, park only on failure — avoids lost wakeups if paired with unpark after successful\r\n  mutation.\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[22m\r\n\r\n"]
[329.958925333,"o","  \u001b[1m\u001b[38;2;147;197;253m9. Batching\u001b[39m\u001b[22m\r\n\r\n  Reduce \u001b[38;2;168;181;230mhead\u001b[39m/\u001b[38;2;168;181;230mtail\u001b[39m contention and improve throughput.\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253mProducer-local batch (flush)\u001b[39m\u001b[22m\r\n\r\n  struct ProducerHandle<T> {\r\n      local: Vec<T>,\r\n      batch_cap: usize,\r\n      queue: Arc<Queue<T>>,\r\n  }\r\n  impl<T> ProducerHandle<T> {\r\n      pub fn push(&mut self, v: T) -> Result<(), T> {\r\n          self.local.push(v);\r\n          if self.local.len() >= self.batch_cap {\r\n              self.flush()?;\r\n          }\r\n          Ok(())\r\n      }\r\n      fn flush(&mut self) -> Result<(), ()> {\r\n          for v in self.local.drain(..) {\r\n              self.queue.try_push(v).map_err(|_| ())?;\r\n          }\r\n          Ok(())\r\n      }\r\n  }\r\n\r\n  Not strictly MPMC on the fast path — \u001b[1mone logical producer per handle\u001b[22m; many handles share the queue.\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253mMulti-dequeue (consumer batch)\u001b[39m\u001b[22m\r\n\r\n  If algorithm allows reading without advancing \u001b[38;2;168;181;230mhead\u001b[39"]
[329.971811333,"o","m until batch committed:\r\n\r\n  \u001b[2m1.\u001b[22m Consumer reads \u001b[38;2;168;181;230mhead_pos\u001b[39m, checks \u001b[38;2;168;181;230mk\u001b[39m consecutive slots ready.\r\n  \u001b[2m2.\u001b[22m Single \u001b[38;2;168;181;230mhead.fetch_add(k, Relaxed)\u001b[39m or one CAS on \u001b[38;2;168;181;230mhead\u001b[39m from \u001b[38;2;168;181;230mh\u001b[39m to \u001b[38;2;168;181;230mh+k\u001b[39m.\r\n  \u001b[2m3.\u001b[22m Drain \u001b[38;2;168;181;230mk\u001b[39m items.\r\n\r\n  Vyukov supports this with a post-loop that doesn't publish each slot until batch end — variant: \u001b[1mreserve\u001b[22m \u001b[38;2;168;181;230mk\u001b[39m via one\r\n  tail CAS (MPMC extensions exist; document as \u001b[38;2;168;181;230mtry_pop_batch(&mut [MaybeUninit<T>]) -> usize\u001b[39m).\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253mAdaptive batching\u001b[39m\u001b[22m\r\n\r\n  let mut spin = 0;\r\n  while !ready {\r\n      if spin < MAX_SPIN { spin += 1; std::hint::spin_loop(); }\r\n      else { std::thread::yield_now(); }\r\n  }\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[22m\r\n\r\n  \u001b[1m\u001b[38;2;147;197;"]
[329.981413833,"o","253m10. Error Types and Backpressure\u001b[39m\u001b[22m\r\n\r\n  pub enum TryPushError<T> {\r\n      Full(T),\r\n  }\r\n  pub enum TryPopError {\r\n      Empty,\r\n  }\r\n\r\n  Bounded: \u001b[38;2;168;181;230mFull\u001b[39m is lock-free backpressure. Unbounded: \u001b[38;2;168;181;230mtry_push\u001b[39m always succeeds unless OOM; use \u001b[38;2;168;181;230mpush_with_alloc\u001b[39m\r\n  returning \u001b[38;2;168;181;230mResult<(), AllocError>\u001b[39m.\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[22m\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253m11. Validation Strategy\u001b[39m\u001b[22m\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253m11.1 Loom (model checking)\u001b[39m\u001b[22m\r\n\r\n  [dev-dependencies]\r\n  loom = { version = \"0.7\", features = [\"checkpoint\"] }\r\n\r\n  #[cfg(loom)]\r\n  use loom::sync::atomic::{AtomicUsize, Ordering};\r\n  #[cfg(loom)]\r\n  use loom::thread;\r\n  #[test]\r\n  fn mpmc_bounded_loom() {\r\n      loom::model(|| {\r\n          let q = Queue::new(4);\r\n          let q = Arc::new(q);\r\n          let mut handles = vec![];\r\n          for i"]
