[221.524814,"o","\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G  struct BlockingQueue<T> {\r\n      inner: Queue<T>,\r\n      not_empty: ParkerList,   // waiters blocked on pop\r\n      not_full: ParkerList,    // bounded only\r\n  }\r\n  impl<T> BlockingQueue<T> {\r\n      pub fn push(&self, v: T) {\r\n          loop {\r\n              match self.inner.try_push(v) {\r\n                  Ok(()) => { self.not_empty.unpark_one(); return; }\r\n                  Err(TryPushError::Full(v)) => {\r\n                      self.not_full.park();  // or park_timeout\r\n                      v = v; // retry\r\n                  }\r\n              }\r\n          }\r\n      }\r\n\r\n \u001b[32m⠰⠰\u001b[39m \u001b[1mComposing\u001b[22m \u001b[2m 2.66k tokens\u001b[22m\r\n\r\n \u001b[48;2;21;21;21m                                                                                                                      \u001b[49m\r\n \u001b[48;2;21;21;21m \u001b[2m→ \u001b[22m\u001b[7mA\u001b[27m\u001b[2mdd a follow-up\u001b[22m         "]
