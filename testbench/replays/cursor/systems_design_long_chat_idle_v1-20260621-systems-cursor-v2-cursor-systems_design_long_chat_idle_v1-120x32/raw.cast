[330.012145833,"o","──────┘\u001b[22m\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253m11.2 Miri\u001b[39m\u001b[22m\r\n\r\n  MIRIFLAGS=\"-Zmiri-tag-raw-pointers\" cargo +nightly miri test\r\n\r\n  Catches:\r\n\r\n  \u001b[2m•\u001b[22m Invalid \u001b[38;2;168;181;230mMaybeUninit\u001b[39m access\r\n  \u001b[2m•\u001b[22m Data races on non-atomic \u001b[38;2;168;181;230mUnsafeCell\u001b[39m data\r\n  \u001b[2m•\u001b[22m Alignment / aliasing violations\r\n\r\n  Miri is weak on weak memory — combine with Loom. Use \u001b[38;2;168;181;230m#[cfg(miri)]\u001b[39m smaller capacities and timeouts.\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253m11.3 ThreadSanitizer (TSan)\u001b[39m\u001b[22m\r\n\r\n  RUSTFLAGS=\"-Zsanitizer=thread\" \\\r\n    cargo +nightly test -Zbuild-std --target x86_64-unknown-linux-gnu\r\n\r\n  \u001b[2m┌─────────────────┬───────────────────────────────────────────────────────────────────┐\u001b[22m\r\n  \u001b[2m│ \u001b[22m\u001b[1mCheck          \u001b[22m\u001b[2m │ \u001b[22m\u001b[1mMethod                            "]
