[328.685737916,"o","                                  \u001b[2m │\u001b[22m\r\n  \u001b[2m└─────────────────────────┴────────────────────────────────────────┴─────────────────────────────────────────────┘\u001b[22m\r\n\r\n  \u001b[1mAvoid \u001b[38;2;168;181;230mSeqCst\u001b[39m\u001b[22m unless a single counter needs global total order (e.g. strict \u001b[38;2;168;181;230mlen()\u001b[39m). Prefer:\r\n\r\n  fn approximate_len(&self) -> usize {\r\n      let t = self.tail.0.load(Relaxed);\r\n      let h = self.head.0.load(Relaxed);\r\n      t.wrapping_sub(h)\r\n  }\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253mUnbounded\u001b[39m\u001b[22m\r\n\r\n  \u001b[2m┌────────────────────────────────────┬──────────────────────────────────────────────┐"]
