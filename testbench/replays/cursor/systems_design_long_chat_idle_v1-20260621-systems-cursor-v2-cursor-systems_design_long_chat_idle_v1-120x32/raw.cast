[328.725363791,"o","──────────────┴──────────────────────────────────────────────┘\u001b[22m\r\n\r\n  \u001b[1mRust atomics rule:\u001b[22m data in \u001b[38;2;168;181;230mUnsafeCell\u001b[39m / \u001b[38;2;168;181;230mMaybeUninit\u001b[39m is only accessed after the matching \u001b[38;2;168;181;230mAcquire\u001b[39m load on the\r\n  synchronizing atomic.\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[22m\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253m6. ABA\u001b[39m\u001b[22m\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253mBounded — no classic ABA\u001b[39m\u001b[22m\r\n\r\n  Slots are indices + generation (\u001b[38;2;168;181;230msequence\u001b[39m), not freelisted pointers. A stale CAS on \u001b[38;2;168;181;230mhead\u001b[39m/\u001b[38;2;168;181;230mtail\u001b[39m might retry but\r\n  cannot resurrect a freed address.\r\n\r\n  \u001b[1mStale position CAS:\u001b[22m producer gets \u001b[38;2;168;181;230mtail_pos\u001b[39m, stalls, ring wraps; slot recycled. On resume, \u001b[38;2;168;181;230m"]
[328.73698375,"o","sequence != tail_pos\u001b[39m →\r\n  spin or reclaim new position. Correctness holds; only latency hit.\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253mUnbounded — ABA is real\u001b[39m\u001b[22m\r\n\r\n  Reuse of \u001b[38;2;168;181;230mNode\u001b[39m allocations without tags can make \u001b[38;2;168;181;230mhead\u001b[39m CAS succeed on wrong memory.\r\n\r\n  \u001b[1mMitigations (pick one primary):\u001b[22m\r\n\r\n  \u001b[2m1.\u001b[22m \u001b[1mTagged pointers\u001b[22m — \u001b[38;2;168;181;230mAtomicU128\u001b[39m / \u001b[38;2;168;181;230mAtomic<{ptr, tag}>\u001b[39m on x86-64; bump tag on each CAS. Rust:\r\n     \u001b[38;2;168;181;230mcrossbeam_utils::CachePadded<AtomicU128>\u001b[39m packing ptr + counter.\r\n  \u001b[2m2.\u001b[22m \u001b[1mEpoch reclamation\u001b[22m — node not freed until no thread can see it; no reuse during hazard window.\r\n  \u001b[2m3.\u001b[22m \u001b[1mHazard pointers\u001b[22m — pin \u001b[38;2;168;181;230mnext\u001b[39m before CAS \u001b[38;2;168;181;230mhead\u001b[39m; heavier API (\u001b[38;2;168;181;230mPin\u001b[39m guard).\r\n\r\n  \u001b[1mRecommendation:\u001b[22m epoch (crossbeam-epoch or lightweight in-tree) + 64-bit tag in pointer low bits for extra safety\r\n  on "]
[328.749758458,"o","48-bit VA systems.\r\n\r\n  struct NodePtr<T> {\r\n      ptr: *mut Node<T>,\r\n      tag: usize,\r\n  }\r\n  // CAS compares (ptr, tag); tag increments on successful head advance\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[22m\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253m7. Reclamation and Memory Safety\u001b[39m\u001b[22m\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253mBounded\u001b[39m\u001b[22m\r\n\r\n  // Push\r\n  ptr::write(cell.data.get(), value);\r\n  cell.sequence.store(tail_pos + 1, Release);\r\n  // Pop\r\n  let v = ptr::read(cell.data.get());\r\n  cell.sequence.store(head_pos + C, Release);\r\n\r\n  \u001b[2m•\u001b[22m On \u001b[38;2;168;181;230mdrop(queue)\u001b[39m: load \u001b[38;2;168;181;230mhead\u001b[39m/\u001b[38;2;168;181;230mtail\u001b[39m, drain all initialized slots, or document requirement that queue be empty.\r\n  \u001b[2m•\u001b[22m Use \u001b[38;2;168;181;230mMaybeUninit\u001b[39m everywhere; never \u001b[38;2;168;181;230mDrop\u001b[39m uninit slot.\r\n  \u001b[2m•\u001b[22m \u001b[38;2;168;181;230mT\u001b[39m dropped only on successful \u001b[38;2;168;181;230mpop\u001b[39m o"]
[328.759858625,"o","r queue drop.\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253mUnbounded\u001b[39m\u001b[22m\r\n\r\n  Integrate \u001b[1mepoch GC\u001b[22m:\r\n\r\n  fn pop(&self) -> Option<T> {\r\n      let guard = self.epoch.pin();\r\n      // ... CAS head ...\r\n      guard.defer_destroy(old_head);  // batch frees\r\n      Some(value)\r\n  }\r\n\r\n  \u001b[2m┌───────────────────┬─────────────────────────────────┬─────────────────────────┐\u001b[22m\r\n  \u001b[2m│ \u001b[22m\u001b[1mScheme           \u001b[22m\u001b[2m │ \u001b[22m\u001b[1mPros                           \u001b[22m\u001b[2m │ \u001b[22m\u001b[1mCons                   \u001b[22m\u001b[2m │\u001b[22m\r\n  \u001b[2m├───────────────────┼─────────────────────────────────┼─────────────────────────┤\u001b[22m\r\n  \u001b[2m│ \u001b[22mEpoch            \u001b[2m │ \u001b[22mFast amortized, good Rust story\u001b[2m"]
[328.770341416,"o"," │ \u001b[22mPeriodic global advance\u001b[2m │\u001b[22m\r\n  \u001b[2m├───────────────────┼─────────────────────────────────┼─────────────────────────┤\u001b[22m\r\n  \u001b[2m│ \u001b[22mHazard pointers  \u001b[2m │ \u001b[22mBounded memory per thread      \u001b[2m │ \u001b[22mPin API, more branches \u001b[2m │\u001b[22m\r\n  \u001b[2m├───────────────────┼─────────────────────────────────┼─────────────────────────┤\u001b[22m\r\n  \u001b[2m│ \u001b[22mNever free (pool)\u001b[2m │ \u001b[22mNo ABA on pool indices         \u001b[2m │ \u001b[22mCap on live nodes      \u001b[2m │\u001b[22m\r\n  \u001b[2m└───────────────────┴─────────────────────────────────┴───────────"]
[328.778005041,"o","──────────────┘\u001b[22m\r\n\r\n  \u001b[1mThread exit:\u001b[22m registered teardown flushes deferred nodes; \u001b[38;2;168;181;230m#[destructor]\u001b[39m or epoch's \u001b[38;2;168;181;230mRegistry::unregister\u001b[39m.\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[22m\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253m8. Blocking Wrappers\u001b[39m\u001b[22m\r\n\r\n  Lock-free core stays non-blocking; blocking is a \u001b[1mwrapper\u001b[22m.\r\n\r\n  struct BlockingQueue<T> {\r\n      inner: Queue<T>,\r\n      not_empty: ParkerList,   // waiters blocked on pop\r\n      not_full: ParkerList,    // bounded only\r\n  }\r\n  impl<T> BlockingQueue<T> {\r\n      pub fn push(&self, v: T) {\r\n          loop {\r\n              match self.inner.try_push(v) {\r\n                  Ok(()) => { self.not_empty.unpark_one(); return; }\r\n                  Err(TryPushError::Full(v)) => {\r\n                      self.not_full.park();  // or park_timeout\r\n                      v = v; // retry\r\n                  }\r\n  "]
[328.78597175,"o","            }\r\n          }\r\n      }\r\n      pub fn pop(&self) -> T {\r\n          loop {\r\n              if let Some(v) = self.inner.try_pop() {\r\n                  self.not_full.unpark_one();\r\n                  return v;\r\n              }\r\n              self.not_empty.park();\r\n          }\r\n      }\r\n  }\r\n\r\n  \u001b[1mDesign choices\u001b[22m\r\n\r\n  \u001b[2m┌───────────────┬────────────────────────────────────────────────────────────────────────────────────────────────┐\u001b[22m\r\n  \u001b[2m│ \u001b[22m\u001b[1mTopic        \u001b[22m\u001b[2m │ \u001b[22m\u001b[1mRecommendation                                                                                \u001b[22m\u001b[2m │\u001b[22m\r\n  \u001b[2m├───────────────┼─────────────────────────────────────"]
[328.794503,"o","───────────────────────────────────────────────────────────┤\u001b[22m\r\n  \u001b[2m│ \u001b[22mParker impl  \u001b[2m │ \u001b[22mcrossbeam_utils::WaitGroup / futex on Linux / std::thread::park per waiter with               \u001b[2m │\u001b[22m\r\n  \u001b[2m│ \u001b[22m             \u001b[2m │ \u001b[22mmutex-protected list                                                                          \u001b[2m │\u001b[22m\r\n  \u001b[2m├───────────────┼────────────────────────────────────────────────────────────────────────────────────────────────┤\u001b[22m\r\n  \u001b[2m│ \u001b[22mSpin-then-par\u001b[2m │ \u001b[22mSpin ~100–1000 iterations before park (bounded queue often succeeds)                          \u001b[2m │\u001b[22m\r\n  \u001b[2m│ \u001b[22mk            "]
