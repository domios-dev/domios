[328.636043791,"o","─────────────────────────────────────────────┘\u001b[22m\r\n\r\n  \u001b[1mTopology-aware layout:\u001b[22m allocate \u001b[38;2;168;181;230mbuffer\u001b[39m on its own pages if \u001b[38;2;168;181;230mC\u001b[39m is huge; NUMA pinning is out of scope but document\r\n  \"single-socket sweet spot.\"\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[22m\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253m5. Memory Ordering\u001b[39m\u001b[22m\r\n\r\n  Use the \u001b[1mminimal\u001b[22m ordering that establishes happens-before.\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253mBounded\u001b[39m\u001b[22m\r\n\r\n  \u001b[2m┌─────────────────────────┬────────────────────────────────────────┬─────────────────────────────────────────────┐\u001b[22m\r\n  \u001b[2m│"]
