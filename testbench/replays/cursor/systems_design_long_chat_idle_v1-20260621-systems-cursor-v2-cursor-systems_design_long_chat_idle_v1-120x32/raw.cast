[328.414451291,"o","────────────┼───────────────────────────┼───────────────────────────────────┤\u001b[22m\r\n  \u001b[2m│ \u001b[22mSweet spot    \u001b[2m │ \u001b[22mLarge rings, cache layers\u001b[2m │ \u001b[22mSmall–medium N, weights, replicas\u001b[2m │\u001b[22m\r\n  \u001b[2m└────────────────┴───────────────────────────┴───────────────────────────────────┘\u001b[22m\r\n\r\n  \u001b[1mOne line:\u001b[22m HRW is the cleaner algorithm when N is modest; CH buys sublinear lookup with a heavier, vnode-tuned\r\n  ring. The membership-stability property is shared; the tradeoff is \u001b[1mindex + memory vs simplicity + perfect weights\u001b[22m.\r\n\r\n \u001b[48;2;36;36;40m                                                                                                                      \u001b[49m\r\n "]
[328.426841333,"o","\u001b[48;2;36;36;40m Now design a lock-free MPMC queue in Rust. Cover bounded vs unbounded, cache lines, memory ordering, ABA,            \u001b[49m\r\n \u001b[48;2;36;36;40m reclamation, blocking wrappers, batching, and validation with loom/miri/TSan. Use numbered sections.                 \u001b[49m\r\n \u001b[48;2;36;36;40m                                                                                                                      \u001b[49m\r\n\r\n  \u001b[4m\u001b[1m\u001b[38;2;147;197;253mLock-Free MPMC Queue in Rust — Design\u001b[39m\u001b[22m\u001b[24m\r\n\r\n  A practical design for a production-grade MPMC queue: bounded Vyukov-style core, optional unbounded extension,\r\n  Rust-safe reclamation, and a validation strategy.\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[22m\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253m1. Goals and API Surface\u001b[39m\u001b[22m\r\n\r\n  pub struct Queue<T> { /* ... */ }\r\n  impl<T> Queue<T> {\r\n      pub fn new(capacity: usize) -> Self;           // bounded\r\n      pub fn unboun"]
[328.445678541,"o","ded() -> Self;                    // optional extension\r\n      pub fn try_push(&self, value: T) -> Result<(), TryPushError<T>>;\r\n      pub fn try_pop(&self) -> Option<T>;\r\n      pub fn len(&self) -> usize;                    // approximate OK\r\n      pub fn is_empty(&self) -> bool;                // approximate OK\r\n  }\r\n  // Blocking layer (separate type or feature flag)\r\n  pub struct BlockingQueue<T> { /* wraps Queue + parkers */ }\r\n\r\n  \u001b[1mSemantics\u001b[22m\r\n\r\n  \u001b[2m┌───────────┬────────────────────────────────────────────────────────────────────────────────────────────────────┐\u001b[22m\r\n  \u001b[2m│ \u001b[22m\u001b[1mProperty \u001b[22m\u001b[2m │ \u001b[22m\u001b[1mChoice                                                                                            \u001b[22m\u001b[2m │\u001b[22m\r\n  \u001b[2m├─────────"]
[328.47014625,"o","──┼────────────────────────────────────────────────────────────────────────────────────────────────────┤\u001b[22m\r\n  \u001b[2m│ \u001b[22mProgress \u001b[2m │ \u001b[22mLock-free: some thread makes progress in finite steps                                             \u001b[2m │\u001b[22m\r\n  \u001b[2m├───────────┼────────────────────────────────────────────────────────────────────────────────────────────────────┤\u001b[22m\r\n  \u001b[2m│ \u001b[22mOrdering \u001b[2m │ \u001b[22mFIFO per pair of enqueuer/dequeuer; global FIFO not guaranteed under extreme MPMC contention      \u001b[2m │\u001b[22m\r\n  \u001b[2m│ \u001b[22m         \u001b[2m │ \u001b[22m(standard f"]
[328.495176,"o","or Vyukov/MS)                                                                          \u001b[2m │\u001b[22m\r\n  \u001b[2m├───────────┼────────────────────────────────────────────────────────────────────────────────────────────────────┤\u001b[22m\r\n  \u001b[2m│ \u001b[22mSend +   \u001b[2m │ \u001b[22mYes, when \u001b[38;2;168;181;230mT: Send\u001b[39m                                                                                 \u001b[2m │\u001b[22m\r\n  \u001b[2m│ \u001b[22mSync     \u001b[2m │ \u001b[22m                                                                                                  \u001b[2m │\u001b[22m\r\n  \u001b[2m├───────────┼─────────────────────────────────────────────────────────────────"]
[328.520717958,"o","───────────────────────────────────┤\u001b[22m\r\n  \u001b[2m│ \u001b[22mDrop     \u001b[2m │ \u001b[22mDrain or leak policy documented; bounded slots use \u001b[38;2;168;181;230mMaybeUninit\u001b[39m                                    \u001b[2m │\u001b[22m\r\n  \u001b[2m└───────────┴────────────────────────────────────────────────────────────────────────────────────────────────────┘\u001b[22m\r\n\r\n  Provide \u001b[1mtwo implementations\u001b[22m behind one trait, not one algorithm for both:\r\n\r\n  \u001b[2m1.\u001b[22m \u001b[1mBounded\u001b[22m — array + per-slot sequence (Vyukov). No pointer reclamation.\r\n  \u001b[2m2.\u001b[22m \u001b[1mUnbounded\u001b[22m — Michael–Scott–style list + epoch reclamation. Higher overhead, unbounded memory.\r\n\r\n  \u001b[2m─────────────────────"]
[328.53493875,"o","───────────────────\u001b[22m\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253m2. Bounded Queue: Structure (Vyukov MPMC)\u001b[39m\u001b[22m\r\n\r\n  Power-of-two capacity \u001b[38;2;168;181;230mC\u001b[39m. Slot \u001b[38;2;168;181;230mi\u001b[39m holds:\r\n\r\n  \u001b[38;2;230;237;243m#[repr(\u001b[38;2;255;166;87mC\u001b[38;2;230;237;243m)]\u001b[39m\r\n  \u001b[38;2;255;123;114mstruct\u001b[38;2;230;237;243m \u001b[38;2;255;166;87mCell\u001b[38;2;230;237;243m<\u001b[38;2;255;166;87mT\u001b[38;2;230;237;243m> {\u001b[39m\r\n  \u001b[38;2;230;237;243m    sequence\u001b[38;2;255;123;114m:\u001b[38;2;230;237;243m \u001b[38;2;255;166;87mAtomicUsize\u001b[38;2;230;237;243m,   \u001b[38;2;139;148;158m// state machine for this slot\u001b[39m\r\n  \u001b[38;2;230;237;243m    data\u001b[38;2;255;123;114m:\u001b[38;2;230;237;243m \u001b[38;2;255;166;87mUnsafeCell\u001b[38;2;230;237;243m<\u001b[38;2;255;166;87mMaybeUninit\u001b[38;2;230;237;243m<\u001b[38;2;255;166;87mT\u001b[38;2;230;237;243m>>,\u001b[39m\r\n  \u001b[38;2;230;237;243m}\u001b[39m\r\n  \u001b[38;2;255;123;114mstruct\u001b[38;2;230;237;243m \u001b[38;2;255;166;87mQueue\u001b[38;2;230;237;243m<\u001b[38;2;255;166;87mT\u001b[38;2;230;237;243m> {\u001b[39m\r\n  \u001b[38;2;230"]
[328.547346625,"o",";237;243m    buffer\u001b[38;2;255;123;114m:\u001b[38;2;230;237;243m \u001b[38;2;255;166;87mBox\u001b[38;2;230;237;243m<[\u001b[38;2;255;166;87mCell\u001b[38;2;230;237;243m<\u001b[38;2;255;166;87mT\u001b[38;2;230;237;243m>]>,\u001b[39m\r\n  \u001b[38;2;230;237;243m    mask\u001b[38;2;255;123;114m:\u001b[38;2;230;237;243m \u001b[38;2;255;166;87musize\u001b[38;2;230;237;243m,             \u001b[38;2;139;148;158m// C - 1\u001b[39m\r\n  \u001b[38;2;230;237;243m    \u001b[38;2;139;148;158m// Each on its own cache line (§4)\u001b[39m\r\n  \u001b[38;2;230;237;243m    head\u001b[38;2;255;123;114m:\u001b[38;2;230;237;243m \u001b[38;2;255;166;87mCachePadded\u001b[38;2;230;237;243m<\u001b[38;2;255;166;87mAtomicUsize\u001b[38;2;230;237;243m>,\u001b[39m\r\n  \u001b[38;2;230;237;243m    tail\u001b[38;2;255;123;114m:\u001b[38;2;230;237;243m \u001b[38;2;255;166;87mCachePadded\u001b[38;2;230;237;243m<\u001b[38;2;255;166;87mAtomicUsize\u001b[38;2;230;237;243m>,\u001b[39m\r\n  \u001b[38;2;230;237;243m}\u001b[39m\r\n\r\n  \u001b[1mSequence invariant\u001b[22m (slot at index \u001b[38;2;168;181;230mi = pos & mask\u001b[39m):\r\n\r\n  \u001b[2m┌─────────────────────────┬──────────"]
[328.560182041,"o","─────────────────────────────────┐\u001b[22m\r\n  \u001b[2m│ \u001b[22m\u001b[1msequence value\u001b[22m         \u001b[2m │ \u001b[22m\u001b[1mMeaning                                  \u001b[22m\u001b[2m │\u001b[22m\r\n  \u001b[2m├─────────────────────────┼───────────────────────────────────────────┤\u001b[22m\r\n  \u001b[2m│ \u001b[22m\u001b[38;2;168;181;230mpos\u001b[39m                    \u001b[2m │ \u001b[22mEmpty, ready for producer at position \u001b[38;2;168;181;230mpos\u001b[39m\u001b[2m │\u001b[22m\r\n  \u001b[2m├─────────────────────────┼───────────────────────────────────────────┤\u001b[22m\r\n  \u001b[2m│ \u001b[22m\u001b[38;2;168;181;230mpos + 1\u001b[39m                \u001b[2m │ \u001b[22mFull, ready for consumer at position \u001b[38;2;168;181;230mpos\u001b[39m \u001b[2m │\u001b[22m\r\n  \u001b[2m├─────"]
[328.570560541,"o","────────────────────┼───────────────────────────────────────────┤\u001b[22m\r\n  \u001b[2m│ \u001b[22m\u001b[38;2;168;181;230mpos + C\u001b[39m (after consume)\u001b[2m │ \u001b[22mEmpty again for next lap                 \u001b[2m │\u001b[22m\r\n  \u001b[2m└─────────────────────────┴───────────────────────────────────────────┘\u001b[22m\r\n\r\n  \u001b[1mProducer\u001b[22m (position \u001b[38;2;168;181;230mtail_pos\u001b[39m):\r\n\r\n  \u001b[2m1.\u001b[22m \u001b[38;2;168;181;230mtail = tail.fetch_add(1, Relaxed)\u001b[39m (or CAS loop on contended tail).\r\n  \u001b[2m2.\u001b[22m Spin/yield until \u001b[38;2;168;181;230mcell.sequence.load(Acquire) == tail_pos\u001b[39m.\r\n  \u001b[2m3.\u001b[22m Write \u001b[38;2;168;181;230mdata\u001b[39m (plain store into \u001b[38;2;168;181;230mMaybeUninit\u001b[39m).\r\n  \u001b[2m4.\u001b[22m \u001b[38;2;168;181;230mcell.sequence.store(tail_pos + 1, Release)\u001b[39m — p"]
[328.579979041,"o","ublishes element.\r\n\r\n  \u001b[1mConsumer\u001b[22m (position \u001b[38;2;168;181;230mhead_pos\u001b[39m):\r\n\r\n  \u001b[2m1.\u001b[22m \u001b[38;2;168;181;230mhead = head.fetch_add(1, Relaxed)\u001b[39m.\r\n  \u001b[2m2.\u001b[22m Spin until \u001b[38;2;168;181;230mcell.sequence.load(Acquire) == head_pos + 1\u001b[39m.\r\n  \u001b[2m3.\u001b[22m Read and \u001b[38;2;168;181;230massume_init_read()\u001b[39m data.\r\n  \u001b[2m4.\u001b[22m \u001b[38;2;168;181;230mcell.sequence.store(head_pos + C, Release)\u001b[39m — recycles slot.\r\n\r\n    head ──► [ seq,data ] [ seq,data ] ... [ seq,data ] ◄── tail\r\n             index 0      index 1           index C-1\r\n\r\n  No ABA on pointers (§6). Reclamation is in-place slot reuse (§7).\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[22m\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253m3. Unbounded Queue: Structure (Michael–Scott MPMC)\u001b[39m\u001b[22m\r\n\r\n  struct Node<T> {\r\n      data: MaybeUninit<T>,\r\n      next: Atomic<NodePtr<T>>,   // tagged wide pointer\r\n  }\r\n  struct Queue<T> {\r\n      head: CachePadded"]
[328.590989708,"o","<Atomic<NodePtr<T>>>,  // dummy node\r\n      tail: CachePadded<Atomic<NodePtr<T>>>,\r\n      epoch: Epoch,                            // crossbeam-epoch or in-tree\r\n  }\r\n\r\n  \u001b[1mEnqueue\u001b[22m\r\n\r\n  \u001b[2m1.\u001b[22m Allocate \u001b[38;2;168;181;230mnode\u001b[39m (outside critical path if pooled).\r\n  \u001b[2m2.\u001b[22m Loop: load \u001b[38;2;168;181;230mtail\u001b[39m, load \u001b[38;2;168;181;230mtail.next\u001b[39m.\r\n    \u001b[2m•\u001b[22m If \u001b[38;2;168;181;230mnext\u001b[39m is null: CAS \u001b[38;2;168;181;230mtail.next\u001b[39m from null → \u001b[38;2;168;181;230mnode\u001b[39m (Release).\r\n    \u001b[2m•\u001b[22m Else: help advance \u001b[38;2;168;181;230mtail\u001b[39m CAS to \u001b[38;2;168;181;230mnext\u001b[39m.\r\n  \u001b[2m3.\u001b[22m CAS \u001b[38;2;168;181;230mtail\u001b[39m to \u001b[38;2;168;181;230mnode\u001b[39m (may lag; helping fixes it).\r\n\r\n  \u001b[1mDequeue\u001b[22m\r\n\r\n  \u001b[2m1.\u001b[22m Pin epoch guard.\r\n  \u001b[2m2.\u001b[22m Loop: load \u001b[38;2;168;181;230mhead\u001b[39m, \u001b[38;2;168;181;230mtail\u001b[39m, \u001b[38;2;168;181;230mhead.next\u001b[39m.\r\n    \u001b[2m•\u001b[22m Empty if \u001b[38;2;168;181;230mhead == tail && next == null\u001b[39m.\r\n    \u001b[2m•\u001b[22m Else: read "]
[328.602411958,"o","data from \u001b[38;2;168;181;230mnext\u001b[39m, CAS \u001b[38;2;168;181;230mhead\u001b[39m to \u001b[38;2;168;181;230mnext\u001b[39m.\r\n  \u001b[2m3.\u001b[22m Retire old dummy/head via epoch (§7).\r\n\r\n  Unbounded path pays for allocation, tagging, and epoch on every pop.\r\n\r\n  \u001b[2m────────────────────────────────────────\u001b[22m\r\n\r\n  \u001b[1m\u001b[38;2;147;197;253m4. Cache Lines and False Sharing\u001b[39m\u001b[22m\r\n\r\n  \u001b[1mProblem:\u001b[22m \u001b[38;2;168;181;230mhead\u001b[39m and \u001b[38;2;168;181;230mtail\u001b[39m on one 64-byte line → every prod/cons invalidates the other side.\r\n\r\n  const CACHE_LINE: usize = 64;\r\n  #[repr(align(64))]\r\n  struct CachePadded<T>(T);\r\n  // head and tail are separate CachePadded atomics\r\n\r\n  \u001b[2m┌─────────────────────┬───────────────────────────────────────────────────────────────────────"]
