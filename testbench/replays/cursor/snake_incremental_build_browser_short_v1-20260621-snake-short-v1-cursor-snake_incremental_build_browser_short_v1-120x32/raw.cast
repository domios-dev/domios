[276.528882292,"o","3m\u001b[38;2;63;185;80m+\u001b[39m\u001b[22m \u001b[38;2;230;237;243m    const TICK_STEP_MS = 8;\u001b[39m                                                                                  \u001b[49m\r\n    \u001b[38;2;62;62;64m▎\u001b[39m\u001b[1m \u001b[22m\r\n    \u001b[38;2;62;62;64m▎\u001b[39m\u001b[1m \u001b[22m \u001b[38;2;230;237;243m    let snake, dir, nextDir, food, score, gameOver, paused, loopId;\u001b[39m\r\n    \u001b[38;2;62;62;64m▎\u001b[39m\u001b[1m \u001b[22m\r\n    \u001b[38;2;62;62;64m▎\u001b[1m\u001b[48;2;43;63;43m\u001b[38;2;63;185;80m+\u001b[39m\u001b[22m \u001b[38;2;230;237;243m    function getTickMs() {\u001b[39m                                                                                   \u001b[49m\r\n    \u001b[38;2;62;62;64m▎\u001b[1m\u001b[48;2;43;63;43m\u001b[38;2;63;185;80m+\u001b[39m\u001b[22m \u001b[38;2;230;237;243m      return Math.max(MIN_TICK_MS, BASE_TICK_MS - Math.floor(score / 5) * TICK_STEP_MS);\u001b[39m                     \u001b[49m\r\n    \u001b[38;2;62;62;64m▎\u001b[39m \u001b[2m… truncated (5 more lines) · ctrl+r to review\u001b[22m\r\n\r\n  \u001b[37m\u001b[2m \u001b[22m\u001b[39m \u001b[1mEdited\u001b[22m \u001b[2msnake.html\u001b[22m                                                                     "]
[276.541612542,"o","                        \u001b[32m+1\u001b[39m\r\n\r\n    \u001b[38;2;62;62;64m▎\u001b[39m\u001b[1m \u001b[22m \u001b[38;2;230;237;243m      if (head.x === food.x && head.y === food.y) {\u001b[39m\r\n    \u001b[38;2;62;62;64m▎\u001b[39m\u001b[1m \u001b[22m \u001b[38;2;230;237;243m        score++;\u001b[39m\r\n    \u001b[38;2;62;62;64m▎\u001b[39m\u001b[1m \u001b[22m \u001b[38;2;230;237;243m        spawnFood();\u001b[39m\r\n    \u001b[38;2;62;62;64m▎\u001b[1m\u001b[48;2;43;63;43m\u001b[38;2;63;185;80m+\u001b[39m\u001b[22m \u001b[38;2;230;237;243m        if (score % 5 === 0) startLoop();\u001b[39m                                                                    \u001b[49m\r\n    \u001b[38;2;62;62;64m▎\u001b[39m\u001b[1m \u001b[22m \u001b[38;2;230;237;243m      } else {\u001b[39m\r\n    \u001b[38;2;62;62;64m▎\u001b[39m\u001b[1m \u001b[22m \u001b[38;2;230;237;243m        snake.pop();\u001b[39m\r\n    \u001b[38;2;62;62;64m▎\u001b[39m\u001b[1m \u001b[22m \u001b[38;2;230;237;243m      }\u001b[39m\r\n\r\n  \u001b[37m\u001b[2m \u001b[22m\u001b[39m \u001b[1mEdited\u001b[22m \u001b[2msnake.html\u001b[22m                                                                                          \u001b[32m+1\u001b[39m \u001b[31m-1\u001b[39m\r\n\r\n    \u001b[38;2;62;62;64m▎\u001b[39m\u001b[1m \u001b[22m\r\n    \u001b[38;2;62;62;64m▎\u001b[39m\u001b[1m \u001b["]
[276.55397375,"o","22m \u001b[38;2;230;237;243m    function startLoop() {\u001b[39m\r\n    \u001b[38;2;62;62;64m▎\u001b[39m\u001b[1m \u001b[22m \u001b[38;2;230;237;243m      stopLoop();\u001b[39m\r\n    \u001b[38;2;62;62;64m▎\u001b[1m\u001b[48;2;64;38;38m\u001b[38;2;248;81;73m-\u001b[39m\u001b[22m \u001b[38;2;230;237;243m      loopId = setInterval(tick, \u001b[48;2;90;46;46m\u001b[38;2;209;215;224mTICK_MS);\u001b[39m\u001b[48;2;64;38;38m                                                                   \u001b[49m\r\n    \u001b[38;2;62;62;64m▎\u001b[1m\u001b[48;2;43;63;43m\u001b[38;2;63;185;80m+\u001b[39m\u001b[22m \u001b[38;2;230;237;243m      loopId = setInterval(tick, \u001b[48;2;46;90;46m\u001b[38;2;209;215;224mgetTickMs());\u001b[39m\u001b[48;2;43;63;43m                                                               \u001b[49m\r\n    \u001b[38;2;62;62;64m▎\u001b[39m\u001b[1m \u001b[22m \u001b[38;2;230;237;243m    }\u001b[39m\r\n    \u001b[38;2;62;62;64m▎\u001b[39m\u001b[1m \u001b[22m\r\n    \u001b[38;2;62;62;64m▎\u001b[39m\u001b[1m \u001b[22m \u001b[38;2;230;237;243m    function togglePause() {\u001b[39m\r\n\r\n  The snake now speeds up every 5 points. Tick interval starts at 120ms and drops by 8ms at scores 5, 10, 15, and so\r\n   on, down to a minimum of 55ms. Res"]
