{
  "id": "terminal_questions_choice_v1",
  "title": "Provider-native question and choice surfaces",
  "providers": [
    "claude",
    "opencode",
    "codex",
    "cursor"
  ],
  "first_capture": "codex",
  "workspace_setup": {
    "files": [],
    "terminal": {
      "cols": 120,
      "rows": 32
    }
  },
  "pacing": {
    "strategy": "adaptive_stability",
    "min_dwell_ms": 1200,
    "stability_quiet_ms": 2500,
    "max_wait_ms": 180000,
    "tolerate_volatile_rows": true
  },
  "focus_churn": {
    "enabled": true,
    "cycles": 5,
    "delay_ms": 250
  },
  "turns": [
    {
      "n": 1,
      "user": "Create a TODO/checklist if your UI supports it. Then propose three approaches labeled A, B, and C for a tiny notes app. Use your normal internal planning or choice UI if your provider has one; otherwise write plain text. Do not execute anything yet.",
      "expect": {
        "phases": [
          "working",
          "idle",
          "question"
        ],
        "card": "none",
        "target": "provider_choice_surface",
        "negative": "abc_prose_must_not_false_question"
      },
      "idle_after_ms": 10000,
      "focus_churn": {
        "enabled": true,
        "cycles": 5,
        "delay_ms": 250
      }
    },
    {
      "n": 2,
      "user": "Pick option B yourself and implement a minimal notes.html file. If you need confirmation or permission, use the provider's normal terminal prompt/menu rather than inventing prose.",
      "expect": {
        "phases": [
          "working",
          "idle",
          "question"
        ],
        "card": "none",
        "target": "permission_or_choice_surface"
      },
      "idle_after_ms": 10000,
      "focus_churn": {
        "enabled": true,
        "cycles": 5,
        "delay_ms": 250
      }
    },
    {
      "n": 3,
      "user": "Now explain, in plain text only, a fake menu with: 1. Alpha, 2. Beta, 3. Gamma. This is a negative case: do not open a real menu, just write prose.",
      "expect": {
        "phases": [
          "working",
          "idle"
        ],
        "card": "none",
        "negative": "numbered_menu_in_prose"
      },
      "idle_after_ms": 12000,
      "focus_churn": {
        "enabled": true,
        "cycles": 6,
        "delay_ms": 250
      }
    },
    {
      "n": 4,
      "user": "Ask me one clarifying question if your normal provider UI supports a blocking question. If not, state that no blocking question UI is available and stop.",
      "expect": {
        "phases": [
          "working",
          "idle",
          "question"
        ],
        "card": "none",
        "target": "blocking_question_attempt"
      },
      "idle_after_ms": 15000,
      "focus_churn": {
        "enabled": true,
        "cycles": 8,
        "delay_ms": 250
      }
    }
  ],
  "stop": {
    "after_final_idle_ms": 12000,
    "focus_churn": true
  },
  "oracle": {
    "forbid_card_on_all_negative_frames": true,
    "require_no_working_during_idle_holds": true,
    "allow_state_question_without_card": true
  }
}
