[197.570755291,"o","\u001b[?25l\u001b[2D\u001b[3B\r\u001b[6A\u001b[38;2;153;153;153m⏺\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(snake.html)\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m·\u001b[39m \u001b[38;2;235;159;127mSe\u001b[38;2;215;119;87masoning… \u001b[38;2;153;153;153m(41s · ↓\u001b[39m \u001b[38;2;153;153;153m2.9k tokens)\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[K\r\r\n\u001b[38;2;136;136;136m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;2;255;193;7m⏵⏵\u001b[6Gauto\u001b[11Gmode\u001b[16Gon\u001b[38;2;153;153;153m (shift+tab\u001b[30Gto\u001b[33Gcycle)\u001b[40G·\u001b[42Gesc\u001b[46Gto\u001b[49Ginterrupt\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
[197.586465875,"o","\u001b[?25l\u001b[2D\u001b[3B\r\u001b[8A\u001b[38;2;78;186;101m⏺\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m12\u001b[15G\u001b[22mlines,\u001b[22Gremoved\u001b[30G\u001b[1m3\u001b[32G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[38;2;248;248;242m\u001b[2m 166 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 167 \u001b[22m   const CELLS = 20;                 // grid is CELLS x CELLS\r\u001b[1B\u001b[39m     \u001b[38;2;248;248;242m\u001b[2m 168 \u001b[22m   const SIZE = canvas.width / CELLS; // pixel size of one cell\u001b[39m\u001b[K\r\u001b[1B  \u001b[6G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 169 -\u001b[38;2;248;248;242m  const BASE_STEP_MS = 110;          // starting time between moves                                   \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;248;248;242m\u001b[2m 169 \u001b[22m   const SPEEDUP_EVERY = 5;           // speed up once per this many points\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;248;248;242m\u001b[2m 170 \u001b[22m   const SPEEDUP_MS = 8;              // ms faster per speed-up tier\u001b[39m\r\r\n\u001b[6G\u001b[38;2;248;248;242m\u001b[2m 171\u001b[11G\u001b[22m \u001b[14Gconst\u001b[20GMIN_STEP_MS\u001b[32G=\u001b[34G55;\u001b[49G//\u001b[52Gfastest\u001b[60Gthe\u001b[64Gsnake\u001b[70Gis\u001b[73Gallowed\u001b[81Gto\u001b[84Ggo\u001b[39m\r\r\n\u001b[6G\u001b[38;2;248;"]
[197.599017791,"o","248;242m\u001b[2m 172\u001b[11G\u001b[22m \u001b[39m\r\r\n\u001b[6G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 174 -\u001b[38;2;248;248;242m  // Time between moves, derived from score. Faster every SPEEDUP_EVERY points.                       \u001b[49m\u001b[39m\r\r\n\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 173 +\u001b[38;2;248;248;242m  // Difficulty sets the starting move interval (lower = faster).                                     \u001b[49m\u001b[39m\r\r\n\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 174 +\u001b[38;2;248;248;242m  const DIFFICULTIES = {                                                                              \u001b[49m\u001b[39m\r\r\n\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 175 +\u001b[38;2;248;248;242m    easy:   { label: 'Easy',   baseStep: 150 },                                                       \u001b[49m\u001b[39m\r\r\n\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 176 +\u001b[38;2;248;248;242m    normal: { label: 'Normal', baseStep: 110 },                                                       \u001b[49m\u001b[39m\r\r\n\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 177 +\u001b[38;2;248;248;242m    hard:   { label: 'Hard',   baseStep: 75  },       "]
