[140.937972375,"o","\u001b[?25l\u001b[2D\u001b[3B\r\u001b[9A\u001b[38;2;78;186;101m⏺\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m10\u001b[15G\u001b[22mlines,\u001b[22Gremoved\u001b[30G\u001b[1m1\u001b[32G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[38;2;248;248;242m\u001b[2m 145 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;248;248;242m\u001b[2m 146 \u001b[22m   const CELLS = 20;                 // grid is CELLS x CELLS\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 147 \u001b[22m   const SIZE = canvas.width / CELLS; // pixel size of one cell\r\u001b[1B\u001b[39m     \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 148 -\u001b[38;2;248;248;242m  const STEP_MS = 110;              // time between moves                                             \u001b[49m\u001b[39m\u001b[K\r\u001b[1B  \u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 148 +\u001b[38;2;248;248;242m  const BASE_STEP_MS = 110;          // starting time between moves                                   \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 149 +\u001b[38;2;248;248;242m  const SPEEDUP_EVERY = 5;           // speed up once per this many points                            \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 150 +\u001b[38;2;248;2"]
[140.948950166,"o","48;242m  const SPEEDUP_MS = 8;              // ms faster per speed-up tier                                   \u001b[49m\u001b[39m\r\r\n\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 151 +\u001b[38;2;248;248;242m  const MIN_STEP_MS = 55;            // fastest the snake is allowed to go                            \u001b[49m\u001b[39m\r\r\n\u001b[6G\u001b[38;2;248;248;242m\u001b[2m 152\u001b[11G\u001b[22m \u001b[39m\r\r\n\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 153 +\u001b[38;2;248;248;242m  // Time between moves, derived from score. Faster every SPEEDUP_EVERY points.                       \u001b[49m\u001b[39m\r\r\n\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 154 +\u001b[38;2;248;248;242m  function stepMs() {                                                                                 \u001b[49m\u001b[39m\r\r\n\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 155 +\u001b[38;2;248;248;242m    const tiers = Math.floor(score / SPEEDUP_EVERY);                                                  \u001b[49m\u001b[39m\r\r\n\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 156 +\u001b[38;2;248;248;242m    return Math.max(MIN_STEP_MS, BASE_STEP_MS - tiers * SPEEDUP_MS);                        "]
