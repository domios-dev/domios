{
  "agentRuntime": {
    "storedHistory": true,
    "runtime": "stdio-jsonrpc",
    "command": {
      "binary": "codex",
      "args": [
        "app-server"
      ]
    },
    "inheritedEnvironmentExclusions": [
      "CODEX_THREAD_ID",
      "CODEX_INTERNAL_ORIGINATOR_OVERRIDE"
    ],
    "requestMethods": {
      "initialize": [
        "initialize",
        "initialized",
        "account/read",
        "account/rateLimits/read"
      ],
      "openThread": [
        "thread/start",
        "thread/inject_items"
      ],
      "resumeThread": [
        "thread/resume",
        "thread/read",
        "thread/unarchive"
      ],
      "readHistory": [
        "thread/turns/list",
        "thread/items/list",
        "thread/goal/get",
        "thread/read"
      ],
      "submitTurn": [
        "turn/start",
        "turn/steer"
      ],
      "interrupt": [
        "turn/interrupt"
      ],
      "control": [
        "thread/settings/update",
        "thread/compact/start",
        "thread/inject_items",
        "account/read",
        "account/login/start",
        "account/login/cancel"
      ]
    },
    "notificationMethods": [
      "account/updated",
      "account/login/completed",
      "thread/started",
      "thread/status/changed",
      "thread/settings/updated",
      "thread/tokenUsage/updated",
      "thread/compacted",
      "thread/goal/updated",
      "thread/goal/cleared",
      "model/rerouted",
      "turn/diff/updated",
      "account/rateLimits/updated",
      "turn/started",
      "turn/completed",
      "turn/plan/updated",
      "item/started",
      "item/completed",
      "item/agentMessage/delta",
      "item/plan/delta",
      "item/reasoning/textDelta",
      "item/reasoning/summaryTextDelta",
      "item/reasoning/summaryPartAdded",
      "item/commandExecution/outputDelta",
      "item/fileChange/outputDelta",
      "item/fileChange/patchUpdated",
      "item/mcpToolCall/progress",
      "serverRequest/resolved",
      "error"
    ],
    "login": {
      "methods": [
        "browser",
        "device",
        "apiKey"
      ],
      "terminalCommand": "codex login"
    },
    "usage": true
  },
  "chatBackend": {
    "spawnable": true,
    "sessionConfig": true,
    "agentTasks": true
  }
}
