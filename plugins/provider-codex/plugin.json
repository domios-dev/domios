{
  "id": "codex",
  "version": "1.14.5",
  "minCodeterm": "1.14.7",
  "hostApi": 2,
  "displayName": "Codex",
  "binaryName": "codex",
  "cliBinary": "codex",
  "capabilities": {
    "agentProvider": true,
    "structuredControl": {
      "protocol": "codex-app-server",
      "minVersion": "0.159.0"
    },
    "agentRuntime": {
      "runtime": "stdio-jsonrpc",
      "command": {
        "binary": "codex",
        "args": [
          "app-server"
        ]
      },
      "inheritedEnvironmentExclusions": [
        "CODEX_THREAD_ID",
        "CODEX_INTERNAL_ORIGINATOR_OVERRIDE"
      ],
      "requestMethods": {
        "initialize": [
          "initialize",
          "initialized",
          "account/read"
        ],
        "openThread": [
          "thread/start",
          "thread/inject_items"
        ],
        "resumeThread": [
          "thread/resume",
          "thread/read",
          "thread/unarchive"
        ],
        "readHistory": [
          "thread/turns/list",
          "thread/items/list",
          "thread/goal/get"
        ],
        "submitTurn": [
          "turn/start",
          "turn/steer"
        ],
        "interrupt": [
          "turn/interrupt"
        ],
        "control": [
          "thread/settings/update",
          "thread/compact/start",
          "thread/inject_items",
          "account/read"
        ]
      },
      "notificationMethods": [
        "account/updated",
        "thread/started",
        "thread/status/changed",
        "thread/settings/updated",
        "thread/tokenUsage/updated",
        "thread/compacted",
        "thread/goal/updated",
        "thread/goal/cleared",
        "model/rerouted",
        "turn/diff/updated",
        "account/rateLimits/updated",
        "turn/started",
        "turn/completed",
        "turn/plan/updated",
        "item/started",
        "item/completed",
        "item/agentMessage/delta",
        "item/plan/delta",
        "item/reasoning/textDelta",
        "item/reasoning/summaryTextDelta",
        "item/commandExecution/outputDelta",
        "item/fileChange/outputDelta",
        "item/mcpToolCall/progress",
        "serverRequest/resolved",
        "error"
      ]
    },
    "chatBackend": {
      "spawnable": true,
      "sessionConfig": true,
      "agentTasks": true
    }
  },
  "iconColor": "var(--ct-fg)",
  "entry": "plugin.js",
  "sessions": {
    "rootDir": "~/.codex",
    "cwdEncoding": "none",
    "searchFiles": {
      "rootSubdir": "sessions",
      "directoryDepth": 3,
      "fileStemRegex": "^rollout-.{19}-([A-Za-z0-9._-]{1,128})$"
    },
    "rootEnvironment": {
      "variable": "CODEX_HOME",
      "subdir": ""
    }
  },
  "credentials": [
    {
      "id": "codexAuth",
      "file": "~/.codex/auth.json",
      "public": {
        "accountId": "tokens.account_id"
      },
      "secret": {
        "accessToken": "tokens.access_token"
      },
      "fileEnvironment": {
        "variable": "CODEX_HOME",
        "subdir": "auth.json"
      }
    }
  ],
  "spawn": {
    "sandboxedLinuxLaunch": {
      "networkAccessArgs": [
        "-c",
        "sandbox_workspace_write.network_access=true"
      ],
      "networkAccessConfigPath": "~/.codex/config.toml",
      "networkAccessSetting": "sandbox_workspace_write.network_access"
    },
    "pasteLimitBytes": 4096,
    "readinessStrategy": {
      "kind": "poll_shell_prompt",
      "timeoutSecs": 30
    },
    "providerReadiness": {
      "kind": "structural_composer",
      "timeoutSecs": 30
    },
    "composerCursorPosition": "bottom_region",
    "taskDelivery": "inline_flag",
    "systemPromptDelivery": {
      "kind": "cli_flag",
      "flag": "-c developer_instructions"
    },
    "verifySubmit": {
      "kind": "tui_input_drained",
      "initialKeyDelayMs": 300,
      "retryOffsetsMs": [
        200,
        500,
        1200,
        2200,
        4000,
        5800
      ]
    },
    "turnEvidenceNormalization": {
      "dropSupplementaryCharacters": true
    },
    "busySubmit": {
      "kind": "submit_normally"
    },
    "sessionIdInjection": "none",
    "statusBarRows": 1,
    "supportsDirectoryTrustPromptParsing": true,
    "agentStateStatusReconciliation": true,
    "supportsLazySkills": false,
    "hasHooks": true,
    "sessionStartsOnFirstUserTurn": true,
    "hookEventRoster": [
      {
        "event": "SessionStart",
        "route": "session_start"
      },
      {
        "event": "Stop",
        "route": "stop"
      },
      {
        "event": "turn/started",
        "route": "session_state",
        "verdict": "working"
      },
      {
        "event": "turn/completed",
        "route": "session_state",
        "verdict": "idle"
      },
      {
        "event": "serverRequest/pending",
        "route": "session_state",
        "verdict": "waiting"
      }
    ],
    "usageProbeCommand": "/status"
  },
  "models": [
    {
      "id": "gpt-6.1-sol",
      "displayName": "GPT-6.1-Sol",
      "description": "Latest workhorse model for coding and everyday work."
    },
    {
      "id": "gpt-6-astra",
      "displayName": "GPT-6-Astra",
      "description": "Frontier intelligence for the most demanding work."
    },
    {
      "id": "gpt-6-sol",
      "displayName": "GPT-6-Sol",
      "description": "Previous generation workhorse model."
    },
    {
      "id": "gpt-6-luna",
      "displayName": "GPT-6-Luna",
      "description": "Fast and affordable model for easier tasks."
    },
    {
      "id": "gpt-5.6-sol",
      "displayName": "GPT-5.6-Sol",
      "description": "Older coding model for complex work."
    },
    {
      "id": "gpt-5.6-terra",
      "displayName": "GPT-5.6-Terra",
      "description": "Older balanced model for straightforward work."
    },
    {
      "id": "gpt-5.6-luna",
      "displayName": "GPT-5.6-Luna",
      "description": "Older fast and efficient model."
    },
    {
      "id": "gpt-5.5",
      "displayName": "GPT-5.5",
      "description": "Legacy coding model."
    }
  ],
  "defaultModel": "gpt-6.1-sol",
  "modelCatalogue": {
    "authority": "authoritative",
    "liveDiscoveryRequired": true
  },
  "reasoningEfforts": [
    {
      "id": "low",
      "displayName": "Low",
      "description": "Fast responses with lighter reasoning."
    },
    {
      "id": "medium",
      "displayName": "Medium",
      "description": "Balances speed and reasoning depth for everyday tasks."
    },
    {
      "id": "high",
      "displayName": "High",
      "description": "Greater reasoning depth for complex problems."
    },
    {
      "id": "xhigh",
      "displayName": "Extra high",
      "description": "Extended reasoning for difficult work."
    }
  ],
  "defaultReasoningEffort": "medium",
  "installer": {
    "macos": "curl -fsSL https://chatgpt.com/codex/install.sh | sh",
    "linux": "curl -fsSL https://chatgpt.com/codex/install.sh | sh",
    "windows": "$s = Join-Path $env:TEMP 'codeterm-codex-install.ps1'; Invoke-WebRequest -Uri 'https://chatgpt.com/codex/install.ps1' -OutFile $s -UseBasicParsing; try { & $s } finally { Remove-Item $s -ErrorAction SilentlyContinue }"
  },
  "updater": {
    "macos": "codex update",
    "linux": "codex update",
    "windows": "codex update"
  },
  "integration": {
    "kind": "provider_managed",
    "settingsPath": "~/.codex/hooks.json",
    "trust_grant": {
      "managedKeys": [
        "session_start",
        "stop"
      ]
    }
  },
  "commands": {
    "compact": "/compact",
    "freshContext": "/new",
    "exit": "/exit",
    "stopKey": "\u001b",
    "autoApproveFlags": [
      "--dangerously-bypass-approvals-and-sandbox",
      "--dangerously-bypass-hook-trust"
    ],
    "modelLaunchArgsFormat": [
      "-m",
      "{model}"
    ],
    "modelSwitch": "next_turn",
    "reasoningEffortLaunchArgsFormat": [
      "-c",
      "model_reasoning_effort=\"{effort}\""
    ],
    "additionalWritableDirFlag": "--add-dir"
  },
  "permissions": {
    "network": {
      "allow": [
        "chatgpt.com",
        "registry.npmjs.org"
      ]
    },
    "subprocess": {
      "allow": [
        "codex"
      ]
    }
  },
  "icon": "icon.svg",
  "cliCompatibility": {
    "supported": [
      "=0.159.0",
      "=0.160.0"
    ],
    "breaking": []
  }
}
