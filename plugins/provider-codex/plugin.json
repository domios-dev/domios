{
  "id": "codex",
  "version": "1.11.7",
  "minCodeterm": "1.11.7",
  "hostApi": 2,
  "displayName": "Codex",
  "binaryName": "codex",
  "cliBinary": "codex",
  "iconColor": "var(--ct-fg)",
  "entry": "plugin.js",
  "sessions": {
    "rootDir": "~/.codex",
    "cwdEncoding": "none"
  },
  "credentials": [
    {
      "id": "codexAuth",
      "file": "~/.codex/auth.json",
      "public": {
        "accountId": "tokens.account_id"
      },
      "secret": {
        "accessToken": "tokens.access_token"
      }
    }
  ],
  "spawn": {
    "readinessStrategy": {
      "kind": "poll_shell_prompt",
      "timeoutSecs": 30
    },
    "taskDelivery": "inline_flag",
    "systemPromptDelivery": {
      "kind": "cli_flag",
      "flag": "-c developer_instructions"
    },
    "verifySubmit": {
      "kind": "tui_input_drained",
      "initialKeyDelayMs": 150
    },
    "busySubmit": {
      "kind": "submit_normally"
    },
    "sessionIdInjection": "none",
    "statusBarRows": 1,
    "supportsDirectoryTrustPromptParsing": true,
    "agentStateStatusReconciliation": true,
    "supportsLazySkills": false,
    "hasHooks": true,
    "hookEventRoster": [
      {
        "event": "SessionStart",
        "route": "session_start"
      },
      {
        "event": "Stop",
        "route": "stop"
      }
    ],
    "usageProbeCommand": "/status"
  },
  "models": [
    {
      "id": "gpt-6-astra",
      "displayName": "GPT-6-Astra",
      "description": "Our most capable model for complex, demanding work."
    },
    {
      "id": "gpt-5.6-sol",
      "displayName": "GPT-5.6-Sol",
      "description": "Reliable agentic workhorse for everyday tasks."
    },
    {
      "id": "gpt-5.6-terra",
      "displayName": "GPT-5.6-Terra",
      "description": "Balanced agentic coding model for everyday work."
    },
    {
      "id": "gpt-5.6-luna",
      "displayName": "GPT-5.6-Luna",
      "description": "Fast and affordable agentic coding model."
    },
    {
      "id": "gpt-5.5",
      "displayName": "GPT-5.5",
      "description": "Proven previous-generation model for coding and general work."
    },
    {
      "id": "gpt-5.3-codex-spark",
      "displayName": "GPT-5.3-Codex-Spark",
      "description": "Ultra-fast coding model."
    }
  ],
  "defaultModel": "gpt-5.5",
  "reasoningEfforts": [
    {
      "id": "low",
      "displayName": "Low",
      "description": "Fast responses with lighter reasoning."
    },
    {
      "id": "medium",
      "displayName": "Medium",
      "description": "Balances speed and reasoning depth for everyday tasks."
    },
    {
      "id": "high",
      "displayName": "High",
      "description": "Greater reasoning depth for complex problems."
    },
    {
      "id": "xhigh",
      "displayName": "Extra high",
      "description": "Extended reasoning for difficult work."
    }
  ],
  "defaultReasoningEffort": "medium",
  "installer": {
    "macos": "curl -fsSL https://chatgpt.com/codex/install.sh | sh",
    "linux": "curl -fsSL https://chatgpt.com/codex/install.sh | sh",
    "windows": "$s = Join-Path $env:TEMP 'codeterm-codex-install.ps1'; Invoke-WebRequest -Uri 'https://chatgpt.com/codex/install.ps1' -OutFile $s -UseBasicParsing; try { & $s } finally { Remove-Item $s -ErrorAction SilentlyContinue }"
  },
  "updater": {
    "macos": "codex update",
    "linux": "codex update",
    "windows": "codex update"
  },
  "integration": {
    "kind": "provider_managed",
    "settingsPath": "~/.codex/hooks.json",
    "trust_grant": {
      "managedKeys": [
        "session_start",
        "stop"
      ]
    }
  },
  "commands": {
    "compact": "/compact",
    "freshContext": "/new",
    "exit": "/exit",
    "stopKey": "\u001b",
    "modelSwitchFormat": "/model {model}",
    "autoApproveFlags": [
      "--dangerously-bypass-approvals-and-sandbox",
      "--dangerously-bypass-hook-trust"
    ],
    "modelLaunchArgsFormat": [
      "-m",
      "{model}"
    ],
    "reasoningEffortLaunchArgsFormat": [
      "-c",
      "model_reasoning_effort=\"{effort}\""
    ]
  },
  "permissions": {
    "network": {
      "allow": [
        "chatgpt.com"
      ]
    },
    "subprocess": {
      "allow": [
        "codex"
      ]
    }
  },
  "icon": "icon.svg"
}
