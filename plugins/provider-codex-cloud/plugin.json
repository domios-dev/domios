{
  "id": "codex-cloud",
  "version": "0.1.0",
  "minCodeterm": "1.14.9",
  "hostApi": 2,
  "displayName": "Codex Cloud",
  "description": "One-shot remote tasks. Live access is unavailable until Cloud authentication is verified.",
  "entry": "plugin.js",
  "dataPaths": ["~/.codeterm/codex-cloud/tasks"],
  "capabilities": {
    "view": true,
    "chatBackend": {
      "spawnable": true,
      "remoteTask": {
        "backend": "chatgpt-cloud-tasks",
        "localProviderId": "codex",
        "availability": {"status": "unavailable", "reason": "Connect a ChatGPT account with Cloud environments. Live Cloud access has not been verified."},
        "environments": [],
        "followUp": false,
        "cancel": false,
        "applyDiff": false
      }
    }
  }
}
