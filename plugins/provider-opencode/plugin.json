{
  "id": "opencode",
  "version": "1.10.9",
  "minCodeterm": "1.10.9",
  "hostApi": 2,
  "displayName": "OpenCode",
  "binaryName": "opencode",
  "cliBinary": "opencode",
  "iconHint": "◇",
  "iconColor": "var(--ct-fg)",
  "iconSvg": "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\" fill-rule=\"evenodd\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M5 3 H19 V21 H5 Z M9 7 H15 V17 H9 Z\"/></svg>",
  "entry": "plugin.js",
  "spawn": {
    "readinessStrategy": {
      "kind": "poll_shell_prompt",
      "timeoutSecs": 30
    },
    "taskDelivery": "inline_flag",
    "systemPromptDelivery": {
      "kind": "session_config"
    },
    "verifySubmit": {
      "kind": "tui_input_drained"
    },
    "sessionIdInjection": "none",
    "statusBarRows": 2,
    "agentStateStatusReconciliation": true,
    "supportsLazySkills": false,
    "hasHooks": true,
    "hookEventRoster": [
      {
        "event": "SessionStart",
        "route": "session_start"
      },
      {
        "event": "session.status",
        "route": "session_state",
        "verdict": "working"
      },
      {
        "event": "session.idle",
        "route": "session_state",
        "verdict": "idle"
      }
    ],
    "supportsStructuredPrompts": true,
    "structuredPromptServer": true
  },
  "models": [
    {
      "id": "anthropic/claude-opus-4-8",
      "displayName": "Claude Opus 4.8",
      "description": "Anthropic Opus via opencode router."
    },
    {
      "id": "anthropic/claude-sonnet-4-6",
      "displayName": "Claude Sonnet 4.6",
      "description": "Anthropic Sonnet via opencode router."
    },
    {
      "id": "opencode/gpt-5.4-mini",
      "displayName": "OpenCode Zen GPT-5.4 Mini",
      "description": "OpenCode Zen hosted GPT model."
    },
    {
      "id": "opencode/gpt-5.5",
      "displayName": "OpenCode Zen GPT-5.5",
      "description": "OpenCode Zen hosted GPT model."
    },
    {
      "id": "opencode/deepseek-v4-flash-free",
      "displayName": "OpenCode Zen DeepSeek V4 Flash Free",
      "description": "OpenCode Zen hosted free DeepSeek model."
    },
    {
      "id": "opencode/big-pickle",
      "displayName": "OpenCode Zen Big Pickle",
      "description": "OpenCode Zen hosted coding model."
    }
  ],
  "defaultModel": "anthropic/claude-opus-4-8",
  "installer": {
    "macos": "curl -fsSL https://opencode.ai/install | bash",
    "linux": "curl -fsSL https://opencode.ai/install | bash",
    "windows": "npm install -g opencode-ai"
  },
  "updater": {
    "macos": "opencode upgrade",
    "linux": "opencode upgrade",
    "windows": "opencode upgrade"
  },
  "commands": {
    "compact": "/compact",
    "freshContext": "/new",
    "exit": "/exit",
    "stopKey": "\u001b",
    "autoApproveFlags": [
      "--dangerously-skip-permissions"
    ],
    "modelLaunchArgsFormat": [
      "-m",
      "{model}"
    ]
  }
}
