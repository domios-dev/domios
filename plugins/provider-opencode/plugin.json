{
  "id": "opencode",
  "version": "1.11.10",
  "minCodeterm": "1.11.10",
  "hostApi": 2,
  "displayName": "OpenCode",
  "binaryName": "opencode",
  "cliBinary": "opencode",
  "badge": "free tokens",
  "iconColor": "var(--ct-fg)",
  "entry": "plugin.js",
  "spawn": {
    "readinessStrategy": {
      "kind": "poll_shell_prompt",
      "timeoutSecs": 30
    },
    "providerReadiness": {
      "kind": "structural_composer",
      "timeoutSecs": 30
    },
    "composerCursorPosition": "visible_anywhere",
    "taskDelivery": "inline_flag",
    "systemPromptDelivery": {
      "kind": "session_config"
    },
    "verifySubmit": {
      "kind": "tui_input_drained"
    },
    "sessionIdInjection": "none",
    "statusBarRows": 2,
    "agentStateStatusReconciliation": true,
    "supportsLazySkills": false,
    "hasHooks": true,
    "sessionStartsOnFirstUserTurn": true,
    "publicSendWaitsForStartupTurnCompletion": true,
    "hookEventRoster": [
      {
        "event": "SessionStart",
        "route": "session_start"
      },
      {
        "event": "session.status",
        "route": "session_state",
        "verdict": "working"
      },
      {
        "event": "session.idle",
        "route": "session_state",
        "verdict": "idle"
      }
    ],
    "supportsStructuredPrompts": true,
    "structuredPromptServer": true
  },
  "credentials": [
    {
      "id": "opencodeAuth",
      "file": "~/.local/share/opencode/auth.json",
      "secret": {
        "deepseekKey": "deepseek.key"
      }
    }
  ],
  "integration": {
    "kind": "plugin_file",
    "settingsPath": "~/.config/opencode/codeterm-session-binding.js"
  },
  "modelGroups": [
    {
      "id": "opencode",
      "label": "OpenCode Zen"
    },
    {
      "id": "deepseek",
      "label": "DeepSeek"
    },
    {
      "id": "xai",
      "label": "xAI"
    }
  ],
  "models": [
    {
      "id": "anthropic/claude-opus-4-8",
      "displayName": "Claude Opus 4.8",
      "description": "Anthropic Opus via opencode router.",
      "group": "Anthropic"
    },
    {
      "id": "anthropic/claude-sonnet-4-6",
      "displayName": "Claude Sonnet 4.6",
      "description": "Anthropic Sonnet via opencode router.",
      "group": "Anthropic"
    },
    {
      "id": "opencode/gpt-5.4-mini",
      "displayName": "OpenCode Zen GPT-5.4 Mini",
      "description": "OpenCode Zen hosted GPT model.",
      "group": "OpenCode Zen"
    },
    {
      "id": "opencode/gpt-5.5",
      "displayName": "OpenCode Zen GPT-5.5",
      "description": "OpenCode Zen hosted GPT model.",
      "group": "OpenCode Zen"
    },
    {
      "id": "opencode/deepseek-v4-flash-free",
      "displayName": "OpenCode Zen DeepSeek V4 Flash Free",
      "description": "OpenCode Zen hosted free DeepSeek model.",
      "group": "OpenCode Zen"
    },
    {
      "id": "opencode/big-pickle",
      "displayName": "OpenCode Zen Big Pickle",
      "description": "OpenCode Zen hosted coding model.",
      "group": "OpenCode Zen"
    }
  ],
  "defaultModel": "anthropic/claude-opus-4-8",
  "modelCatalogue": {
    "authority": "free_form"
  },
  "installer": {
    "macos": "curl -fsSL https://opencode.ai/install | bash",
    "linux": "curl -fsSL https://opencode.ai/install | bash",
    "windows": "npm install -g opencode-ai"
  },
  "updater": {
    "macos": "opencode upgrade",
    "linux": "opencode upgrade",
    "windows": "opencode upgrade"
  },
  "commands": {
    "compact": "/compact",
    "freshContext": "/new",
    "exit": "/exit",
    "stopKey": "\u001b",
    "autoApproveFlags": [
      "--dangerously-skip-permissions"
    ],
    "modelLaunchArgsFormat": [
      "-m",
      "{model}"
    ]
  },
  "permissions": {
    "network": {
      "allow": [
        "api.deepseek.com"
      ]
    }
  },
  "icon": "icon.svg"
}
