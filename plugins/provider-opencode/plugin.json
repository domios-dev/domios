{
  "id": "opencode",
  "version": "1.14.32",
  "minCodeterm": "1.20.2",
  "hostApi": 2,
  "capabilities": {
    "attachments": {
      "filePaths": true,
      "inlineText": true,
      "imagePaths": true
    },
    "agentProvider": true,
    "modelProviderConfig": true,
    "decisionModel": {
      "tokenMode": "none"
    },
    "graphNodes": {
      "steps": [
        {
          "contractVersion": 1,
          "revision": 1,
          "id": "opencode.run_prompt",
          "title": "OpenCode: run prompt",
          "description": "Runs one prompt in a separate agent tab using this provider. Lost runs are never resubmitted.",
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prompt",
              "cwd"
            ],
            "properties": {
              "prompt": {
                "type": "string",
                "maxLength": 32768
              },
              "model": {
                "type": "string",
                "maxLength": 128
              },
              "cwd": {
                "type": "string",
                "maxLength": 1024
              },
              "timeout_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600000,
                "default": 600000
              }
            }
          },
          "inputs": {
            "context": {
              "kind": "text",
              "minItems": 0,
              "maxItems": 1
            }
          },
          "outputs": {
            "text": {
              "kind": "text",
              "minItems": 1,
              "maxItems": 1
            }
          },
          "outcomes": [
            "done",
            "failed"
          ],
          "lifecycle": {
            "reconcile": true,
            "cancel": true
          },
          "effects": {
            "sideEffects": true
          }
        }
      ]
    },
    "chatBackend": {
      "spawnable": true,
      "sessionConfig": true,
      "agentTasks": false
    },
    "agentRuntime": {
      "runtime": "http-sse",
      "command": {
        "binary": "opencode",
        "args": [
          "serve",
          "--hostname={httpHost}",
          "--port={httpPort}"
        ]
      },
      "httpSse": {
        "readinessPrefix": "opencode server listening on ",
        "passwordEnv": "OPENCODE_SERVER_PASSWORD",
        "username": "opencode",
        "usernameEnv": "OPENCODE_SERVER_USERNAME",
        "eventPath": "/event",
        "eventMethod": "http/event",
        "requestEvents": {
          "permission.asked": {
            "typePointer": "/type",
            "idPointer": "/properties/id",
            "threadPointer": "/properties/sessionID",
            "replyMethod": "permission.reply",
            "rejectMethod": "permission.reply",
            "rejectBody": {
              "reply": "reject"
            },
            "pathParams": {
              "requestID": "/properties/id"
            }
          },
          "question.asked": {
            "typePointer": "/type",
            "idPointer": "/properties/id",
            "threadPointer": "/properties/sessionID",
            "replyMethod": "question.reply",
            "rejectMethod": "question.reject",
            "pathParams": {
              "requestID": "/properties/id"
            }
          }
        },
        "responseHeaders": [
          "x-next-cursor"
        ],
        "routes": {
          "health": {
            "method": "GET",
            "path": "/global/health"
          },
          "provider.list": {
            "method": "GET",
            "path": "/provider"
          },
          "provider.auth": {
            "method": "GET",
            "path": "/provider/auth"
          },
          "provider.authorize": {
            "method": "POST",
            "path": "/provider/{providerID}/oauth/authorize"
          },
          "provider.callback": {
            "method": "POST",
            "path": "/provider/{providerID}/oauth/callback"
          },
          "provider.key": {
            "method": "PUT",
            "path": "/auth/{providerID}"
          },
          "session.create": {
            "method": "POST",
            "path": "/session"
          },
          "session.get": {
            "method": "GET",
            "path": "/session/{sessionID}"
          },
          "session.messages": {
            "method": "GET",
            "path": "/session/{sessionID}/message"
          },
          "session.prompt": {
            "method": "POST",
            "path": "/session/{sessionID}/prompt_async"
          },
          "session.abort": {
            "method": "POST",
            "path": "/session/{sessionID}/abort"
          },
          "permission.reply": {
            "method": "POST",
            "path": "/permission/{requestID}/reply"
          },
          "question.reply": {
            "method": "POST",
            "path": "/question/{requestID}/reply"
          },
          "question.reject": {
            "method": "POST",
            "path": "/question/{requestID}/reject"
          }
        },
        "alternatives": [
          {
            "readinessPrefix": "server listening on ",
            "passwordEnv": "OPENCODE_PASSWORD",
            "username": "opencode",
            "usernameEnv": "OPENCODE_SERVER_USERNAME",
            "eventPath": "/api/event",
            "eventMethod": "http/event",
            "responseHeaders": [],
            "routes": {
              "health": {
                "method": "GET",
                "path": "/api/info"
              },
              "v2.integration.list": {
                "method": "GET",
                "path": "/api/integration"
              },
              "v2.integration.authorize": {
                "method": "POST",
                "path": "/api/integration/{integrationID}/connect/oauth"
              },
              "v2.integration.status": {
                "method": "GET",
                "path": "/api/integration/{integrationID}/connect/oauth/{attemptID}"
              },
              "v2.integration.complete": {
                "method": "POST",
                "path": "/api/integration/{integrationID}/connect/oauth/{attemptID}/complete"
              },
              "v2.integration.cancel": {
                "method": "DELETE",
                "path": "/api/integration/{integrationID}/connect/oauth/{attemptID}"
              },
              "v2.integration.key": {
                "method": "POST",
                "path": "/api/integration/{integrationID}/connect/key"
              },
              "v2.session.create": {
                "method": "POST",
                "path": "/api/session"
              },
              "v2.session.get": {
                "method": "GET",
                "path": "/api/session/{sessionID}"
              },
              "v2.session.messages": {
                "method": "GET",
                "path": "/api/session/{sessionID}/message"
              },
              "v2.session.active": {
                "method": "GET",
                "path": "/api/session/active"
              },
              "v2.session.prompt": {
                "method": "POST",
                "path": "/api/session/{sessionID}/prompt"
              },
              "v2.session.model": {
                "method": "POST",
                "path": "/api/session/{sessionID}/model"
              },
              "v2.session.instructions": {
                "method": "PUT",
                "path": "/api/experimental/session/{sessionID}/instructions/entries/{key}"
              },
              "session.abort": {
                "method": "POST",
                "path": "/api/session/{sessionID}/interrupt"
              },
              "v2.permission.reply": {
                "method": "POST",
                "path": "/api/session/{sessionID}/permission/{requestID}/reply"
              },
              "v2.form.reply": {
                "method": "POST",
                "path": "/api/session/{sessionID}/form/{formID}/reply"
              },
              "v2.form.reject": {
                "method": "DELETE",
                "path": "/api/session/{sessionID}/form/{formID}"
              },
              "v2.provider.list": {
                "method": "GET",
                "path": "/api/provider"
              }
            },
            "requestEvents": {
              "permission.asked": {
                "typePointer": "/type",
                "idPointer": "/data/id",
                "threadPointer": "/data/sessionID",
                "replyMethod": "v2.permission.reply",
                "rejectMethod": "v2.permission.reply",
                "rejectBody": {
                  "decision": "reject"
                },
                "pathParams": {
                  "sessionID": "/data/sessionID",
                  "requestID": "/data/id"
                }
              },
              "form.created": {
                "typePointer": "/type",
                "idPointer": "/data/form/id",
                "threadPointer": "/data/form/sessionID",
                "replyMethod": "v2.form.reply",
                "rejectMethod": "v2.form.reject",
                "pathParams": {
                  "sessionID": "/data/form/sessionID",
                  "formID": "/data/form/id"
                }
              }
            },
            "completionEvents": true
          }
        ],
        "completionEvents": true
      },
      "hostApprovals": true,
      "interrupt": {
        "beforeFirstTurn": true
      },
      "localImagePaths": true,
      "usage": true,
      "turnScopedRequests": [
        "submitTurn"
      ],
      "requestMethods": {
        "initialize": [
          "health",
          "provider.list",
          "provider.auth",
          "v2.integration.list",
          "v2.provider.list"
        ],
        "openThread": [
          "session.create",
          "v2.session.create",
          "v2.session.instructions"
        ],
        "resumeThread": [
          "health",
          "session.get",
          "v2.session.get",
          "v2.session.instructions",
          "v2.session.model"
        ],
        "readHistory": [
          "session.messages",
          "v2.session.messages",
          "v2.session.active"
        ],
        "submitTurn": [
          "session.prompt",
          "v2.session.prompt"
        ],
        "interrupt": [
          "session.abort"
        ],
        "answer": [
          "permission.reply",
          "question.reply",
          "question.reject",
          "v2.permission.reply",
          "v2.form.reply",
          "v2.form.reject"
        ],
        "control": [
          "provider.list",
          "provider.auth",
          "provider.authorize",
          "provider.callback",
          "provider.key",
          "v2.integration.list",
          "v2.integration.authorize",
          "v2.integration.status",
          "v2.integration.complete",
          "v2.integration.cancel",
          "v2.integration.key",
          "v2.provider.list"
        ]
      },
      "notificationMethods": [
        "http/event"
      ]
    }
  },
  "generalAgentOfferWhenAbsent": true,
  "displayName": "OpenCode",
  "binaryName": "opencode",
  "cliBinary": "opencode",
  "badge": "free tokens",
  "iconColor": "var(--ct-fg)",
  "entry": "plugin.js",
  "spawn": {
    "readinessStrategy": {
      "kind": "poll_shell_prompt",
      "timeoutSecs": 30
    },
    "providerReadiness": {
      "kind": "structural_composer",
      "timeoutSecs": 30
    },
    "composerCursorPosition": "visible_anywhere",
    "taskDelivery": "inline_flag",
    "systemPromptDelivery": {
      "kind": "session_config"
    },
    "verifySubmit": {
      "kind": "tui_input_drained"
    },
    "sessionIdInjection": "none",
    "statusBarRows": 2,
    "agentStateStatusReconciliation": true,
    "supportsLazySkills": false,
    "hasHooks": true,
    "sessionStartsOnFirstUserTurn": true,
    "publicSendWaitsForStartupTurnCompletion": true,
    "hookEventRoster": [
      {
        "event": "SessionStart",
        "route": "session_start"
      },
      {
        "event": "session.status",
        "route": "session_state",
        "verdict": "working"
      },
      {
        "event": "session.idle",
        "route": "session_state",
        "verdict": "idle"
      }
    ],
    "supportsStructuredPrompts": true,
    "structuredPromptServer": true
  },
  "credentials": [
    {
      "id": "opencodeAuth",
      "file": "~/.local/share/opencode/auth.json",
      "secret": {
        "deepseekKey": "deepseek.key"
      },
      "fileEnvironment": {
        "variable": "XDG_DATA_HOME",
        "subdir": "opencode/auth.json"
      }
    }
  ],
  "integration": {
    "kind": "plugin_file",
    "settingsPath": "~/.config/opencode/codeterm-session-binding.js"
  },
  "modelGroups": [
    {
      "id": "opencode",
      "label": "OpenCode Zen"
    },
    {
      "id": "deepseek",
      "label": "DeepSeek"
    },
    {
      "id": "xai",
      "label": "xAI"
    }
  ],
  "models": [
    {
      "id": "anthropic/claude-opus-4-8",
      "displayName": "Claude Opus 4.8",
      "description": "Anthropic Opus via opencode router.",
      "group": "Anthropic"
    },
    {
      "id": "anthropic/claude-sonnet-4-6",
      "displayName": "Claude Sonnet 4.6",
      "description": "Anthropic Sonnet via opencode router.",
      "group": "Anthropic"
    },
    {
      "id": "opencode/gpt-5.4-mini",
      "displayName": "OpenCode Zen GPT-5.4 Mini",
      "description": "OpenCode Zen hosted GPT model.",
      "group": "OpenCode Zen"
    },
    {
      "id": "opencode/gpt-5.5",
      "displayName": "OpenCode Zen GPT-5.5",
      "description": "OpenCode Zen hosted GPT model.",
      "group": "OpenCode Zen"
    },
    {
      "id": "opencode/deepseek-v4-flash-free",
      "displayName": "OpenCode Zen DeepSeek V4 Flash Free",
      "description": "OpenCode Zen hosted free DeepSeek model.",
      "group": "OpenCode Zen"
    },
    {
      "id": "opencode/big-pickle",
      "displayName": "OpenCode Zen Big Pickle",
      "description": "OpenCode Zen hosted coding model.",
      "group": "OpenCode Zen"
    }
  ],
  "defaultModel": "anthropic/claude-opus-4-8",
  "modelCatalogue": {
    "authority": "authoritative",
    "configFiles": [
      "~/.config/opencode/opencode.json",
      "~/.config/opencode/opencode.jsonc",
      "opencode.json",
      "opencode.jsonc"
    ],
    "liveDiscoveryRequired": true,
    "configFileEnvironments": [
      {
        "variable": "OPENCODE_CONFIG"
      },
      {
        "variable": "OPENCODE_CONFIG_DIR",
        "subdir": "opencode.json"
      },
      {
        "variable": "OPENCODE_CONFIG_DIR",
        "subdir": "opencode.jsonc"
      },
      {
        "variable": "XDG_CONFIG_HOME",
        "subdir": "opencode/opencode.json"
      },
      {
        "variable": "XDG_CONFIG_HOME",
        "subdir": "opencode/opencode.jsonc"
      }
    ]
  },
  "installer": {
    "macos": "curl -fsSL https://opencode.ai/install | bash",
    "linux": "curl -fsSL https://opencode.ai/install | bash",
    "windows": "npm install -g opencode-ai"
  },
  "updater": {
    "macos": "opencode upgrade {version}",
    "linux": "opencode upgrade {version}",
    "windows": "opencode upgrade {version}"
  },
  "commands": {
    "compact": "/compact",
    "freshContext": "/new",
    "exit": "/exit",
    "stopKeys": [
      "\u001b",
      "\u001b"
    ],
    "stopKeyWaitForOutput": true,
    "autoApproveFlags": [
      "--auto"
    ],
    "modelLaunchArgsFormat": [
      "-m",
      "{model}"
    ],
    "reasoningEffortLaunchArgsFormat": [
      "--variant",
      "{effort}"
    ],
    "modelSwitch": "restart_resume"
  },
  "permissions": {
    "subprocess": {
      "allow": [
        "opencode"
      ]
    },
    "network": {
      "allow": [
        "api.deepseek.com",
        "registry.npmjs.org"
      ]
    },
    "spawnAgents": true
  },
  "icon": "icon.svg",
  "cliCompatibility": {
    "supported": [
      "=1.18.35",
      ">=1.19.0, <1.20.0"
    ],
    "breaking": [
      {
        "range": ">=2.0.0, <3.0.0",
        "reasons": [
          "sqlite_schema_conversion",
          "event_route_changed",
          "server_password_required"
        ]
      }
    ],
    "directSqlite": true
  },
  "hostIoJobs": true
}
