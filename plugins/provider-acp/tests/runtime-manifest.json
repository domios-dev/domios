{
  "agentRuntime": {
    "runtime": "stdio-jsonrpc",
    "command": {
      "binary": "acp-agent",
      "args": []
    },
    "launchProfiles": {
      "deepseek-harness": {
        "binary": "npx",
        "args": [
          "@deepseek-ai/dsh@0.2.1-rc.5",
          "--profile",
          "acp"
        ],
        "install": {
          "package": "@deepseek-ai/dsh@0.2.1-rc.5",
          "registry": "https://registry.npmjs.org"
        },
        "secretEnv": {
          "DEEPSEEK_API_KEY": "domios:provider:acp:deepseek-api-key"
        }
      },
      "gemini-cli": {
        "binary": "gemini",
        "args": [
          "--acp"
        ]
      },
      "local": {
        "binary": "local-acp-command",
        "args": [],
        "ownerConfigured": true
      }
    },
    "requestMethods": {
      "initialize": [
        "initialize"
      ],
      "openThread": [
        "session/new"
      ],
      "resumeThread": [
        "session/load",
        "session/resume"
      ],
      "submitTurn": [
        "session/prompt"
      ],
      "interrupt": [
        "session/cancel"
      ],
      "control": ["initialize", "authenticate"],
      "answer": []
    },
    "notificationMethods": [
      "session/update"
    ]
  },
  "chatBackend": {
    "enabled": true,
    "spawnable": true,
    "sessionConfig": true,
    "agentTasks": true
  },
  "scenarios": [
    "cancel.json",
    "foreign-session-frame.json",
    "initialize-new-prompt.json",
    "load-when-advertised.json",
    "resume-not-advertised.json",
    "resume-when-advertised.json",
    "unsupported-version.json"
  ]
}
