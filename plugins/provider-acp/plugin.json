{
  "id": "acp",
  "version": "0.1.10",
  "minCodeterm": "1.19.2",
  "hostApi": 2,
  "displayName": "ACP",
  "description": "Agent Client Protocol v1 runtime with host-owned launch profiles. See domios docs ACP for profiles, setup, registry and authentication.",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "capabilities": {
    "agentProvider": true,
    "attachments": {
      "filePaths": true,
      "inlineText": true,
      "imagePaths": true
    },
    "agentRuntime": {
      "runtime": "stdio-jsonrpc",
      "envelope": "jsonrpc2",
      "usage": true,
      "hostApprovals": true,
      "command": {
        "binary": "acp-agent",
        "args": []
      },
      "launchProfiles": {
        "antigravity": {
          "binary": "agy",
          "args": [
            "acp"
          ],
          "icon": "antigravity-color.svg",
          "limitsSource": {
            "kind": "quota",
            "reader": "statusline-quota"
          }
        },
        "deepseek-harness": {
          "binary": "npx",
          "args": [
            "@deepseek-ai/dsh@0.2.1-rc.5",
            "--profile",
            "acp"
          ],
          "install": {
            "package": "@deepseek-ai/dsh@0.2.1-rc.5",
            "registry": "https://registry.npmjs.org"
          },
          "secretEnv": {
            "DEEPSEEK_API_KEY": "domios:provider:acp:deepseek-api-key"
          },
          "icon": "deepseek-color.svg",
          "askScope": "outsideWorkspace",
          "limitsSource": {
            "kind": "balance",
            "reader": "deepseek-balance",
            "credentialEnv": "DEEPSEEK_API_KEY"
          }
        },
        "grok-build": {
          "binary": "npx",
          "args": [
            "@xai-official/grok@1.0.93",
            "agent",
            "stdio"
          ],
          "install": {
            "package": "@xai-official/grok@1.0.93",
            "registry": "https://registry.npmjs.org"
          },
          "icon": "grok-build.svg"
        },
        "github-copilot-cli": {
          "binary": "npx",
          "args": [
            "@github/copilot@1.0.114",
            "--acp"
          ],
          "install": {
            "package": "@github/copilot@1.0.114",
            "registry": "https://registry.npmjs.org"
          },
          "icon": "github-copilot-cli.svg"
        },
        "cline": {
          "binary": "npx",
          "args": [
            "cline@3.0.75",
            "--acp"
          ],
          "install": {
            "package": "cline@3.0.75",
            "registry": "https://registry.npmjs.org"
          },
          "icon": "cline.svg"
        },
        "qwen-code": {
          "binary": "npx",
          "args": [
            "@qwen-code/qwen-code@0.28.3",
            "--acp",
            "--experimental-skills"
          ],
          "install": {
            "package": "@qwen-code/qwen-code@0.28.3",
            "registry": "https://registry.npmjs.org"
          },
          "icon": "qwen-code.svg"
        },
        "kimi-code": {
          "binary": "npx",
          "args": [
            "@moonshot-ai/kimi-code@2.7.2",
            "acp"
          ],
          "install": {
            "package": "@moonshot-ai/kimi-code@2.7.2",
            "registry": "https://registry.npmjs.org"
          },
          "icon": "kimi-code.svg"
        },
        "kilo": {
          "binary": "npx",
          "args": [
            "@kilocode/cli@7.8.32",
            "acp"
          ],
          "install": {
            "package": "@kilocode/cli@7.8.32",
            "registry": "https://registry.npmjs.org"
          },
          "icon": "kilo.svg"
        },
        "local": {
          "binary": "local-acp-command",
          "args": [],
          "ownerConfigured": true
        }
      },
      "registryDefaults": {
        "claude-acp": {
          "fullAccessMode": "bypassPermissions",
          "limitsSource": {
            "kind": "account",
            "provider": "claude"
          }
        },
        "codex-acp": {
          "fullAccessMode": "agent-full-access",
          "limitsSource": {
            "kind": "account",
            "provider": "codex"
          }
        },
        "gemini": {
          "fullAccessMode": "yolo",
          "limitsSource": {
            "kind": "quota",
            "reader": "gemini-code-assist"
          }
        }
      },
      "requestMethods": {
        "initialize": [
          "initialize"
        ],
        "openThread": [
          "session/new",
          "session/set_config_option",
          "session/set_model",
          "session/set_mode"
        ],
        "resumeThread": [
          "session/load",
          "session/resume",
          "session/set_config_option",
          "session/set_model",
          "session/set_mode"
        ],
        "forkThread": [
          "session/fork"
        ],
        "submitTurn": [
          "session/prompt",
          "_session/steering"
        ],
        "interrupt": [
          "session/cancel"
        ],
        "control": [
          "initialize",
          "authenticate",
          "session/set_mode",
          "session/set_config_option",
          "session/set_model",
          "session/list",
          "session/close"
        ],
        "answer": []
      },
      "notificationMethods": [
        "session/update",
        "_x.ai/session/update"
      ],
      "clientBridges": {
        "fsRead": true,
        "fsWrite": true,
        "terminal": true
      },
      "interrupt": {
        "beforeFirstTurn": true
      },
      "turnScopedRequests": [
        "submitTurn"
      ],
      "hostMcp": {
        "param": "mcpServers",
        "methods": [
          "session/new",
          "session/load",
          "session/resume",
          "session/fork"
        ]
      }
    },
    "chatBackend": {
      "enabled": true,
      "spawnable": true,
      "sessionConfig": true,
      "agentTasks": false
    }
  },
  "credentials": [
    {
      "id": "geminiSettings",
      "file": "~/.gemini/settings.json",
      "public": {
        "selectedType": "security.auth.selectedType"
      },
      "fileEnvironment": {
        "variable": "GEMINI_CLI_HOME",
        "subdir": ".gemini/settings.json"
      }
    },
    {
      "id": "geminiOauth",
      "file": "~/.gemini/oauth_creds.json",
      "public": {
        "expiresAt": "expiry_date"
      },
      "secret": {
        "accessToken": "access_token"
      },
      "fileEnvironment": {
        "variable": "GEMINI_CLI_HOME",
        "subdir": ".gemini/oauth_creds.json"
      }
    }
  ],
  "permissions": {
    "subprocess": {
      "allow": [
        "acp-agent",
        "npx",
        "agy",
        "local-acp-command"
      ]
    },
    "secrets": true,
    "agent_commands": true,
    "network": {
      "allow": [
        "cdn.agentclientprotocol.com",
        "api.deepseek.com",
        "cloudcode-pa.googleapis.com"
      ]
    }
  },
  "agentVerbs": [
    "registry-search [query]",
    "registry-refresh [query]"
  ],
  "hostIoJobs": true
}
