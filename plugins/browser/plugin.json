{
  "id": "browser",
  "version": "1.13.0",
  "minCodeterm": "1.18.0",
  "hostApi": 2,
  "displayName": "Browser",
  "description": "An agent-owned live browser: the agent drives a real Chromium, the user watches it inside the agent's tab, joins in, and points at elements to ask the agent about them.",
  "entry": "plugin.js",
  "capabilities": {
    "surfaces": [
      {
        "id": "browser",
        "title": "Browser",
        "renderer": "stream",
        "runtime": "browser",
        "agentBound": true,
        "restore": "relaunch",
        "icon": "globe"
      }
    ],
    "graphNodes": {
      "steps": [
        {
          "contractVersion": 1,
          "revision": 1,
          "id": "browser.read_page",
          "title": "Browser: read page",
          "description": "Opens a browser for the run owner, reads one page's text and closes it. Existing owner browsers are left untouched; every run gets a separate surface.",
          "params": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 2048,
                "description": "http(s) page to read; a bound url input wins."
              },
              "wait_text": {
                "type": "string",
                "maxLength": 256,
                "description": "Text to wait for before reading."
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2000,
                "default": 200,
                "description": "Lines of page text to keep."
              }
            }
          },
          "inputs": {
            "url": {
              "kind": "text",
              "minItems": 0,
              "maxItems": 1
            }
          },
          "outputs": {
            "text": {
              "kind": "text",
              "minItems": 1,
              "maxItems": 1
            },
            "final_url": {
              "kind": "text",
              "minItems": 1,
              "maxItems": 1
            }
          },
          "outcomes": [
            "read",
            "navigation_failed",
            "needs_human",
            "browser_busy"
          ],
          "lifecycle": {
            "reconcile": false,
            "cancel": false
          },
          "effects": {
            "sideEffects": false
          }
        }
      ]
    }
  },
  "permissions": {
    "agentCommands": true,
    "surfaces": true
  },
  "agentVerbs": [
    "help (any verb + --of <agent>: act in that agent's browser)",
    "open [url] [--profile NAME] | open --profile NAME --origin URL [--expect-build SHA] [--ephemeral]",
    "status",
    "profiles",
    "goto <url>",
    "back | forward | reload",
    "snapshot [limit] [--json] [--with-text] [--out FILE] [--scope SCOPE] [--actions-only] [--max-items N]",
    "click @ref | <role> <name> | --within role:name --role ROLE --name NAME",
    "type @ref | <role> <name> <text> (or --stdin for masked secret input)",
    "press <key> [shift|ctrl|alt|meta]",
    "scroll <dy>",
    "text [limit] [--out FILE]",
    "wait --text T | --url U | --selector S",
    "screenshot [file] [--full] [--viewport WIDTHxHEIGHT] [--mobile] [--dpr N] [--restore] [--metrics-json]",
    "inbox [all]",
    "annotate @ref | <role> <name> <comment> --of <agent> [--intent question|change|bug]",
    "endpoint",
    "close",
    "attach --profile NAME --origin URL [--expect-build SHA] [--ephemeral]",
    "connect --profile NAME --origin URL [--expect-build SHA] [--ephemeral] --stdin",
    "profile list | profile remove NAME",
    "viewport set WIDTH HEIGHT [--mobile] [--dpr N]",
    "fill --within role:name --role ROLE --name NAME --text TEXT",
    "file-picker choose --paths PATH (unsupported; use Take control)",
    "wait --role ROLE --name NAME --state visible|hidden|enabled|expanded|checked|unchecked|pressed|unpressed|selected|unselected [--timeout DURATION]",
    "expand summary NAME",
    "collapse summary NAME",
    "open --domios-instance NAME --api-port PORT [--ephemeral]"
  ],
  "agentKeywords": [
    "browser",
    "web page",
    "website",
    "click",
    "screenshot",
    "accessibility snapshot",
    "test web ui",
    "form",
    "login"
  ],
  "agentGuide": "BROWSER.md",
  "agentPromptLine": "Browser: a real browser tab the user watches inside Domios — use it for any web page or UI testing task instead of Chrome extensions or other browser tools. How to use: `domios docs BROWSER`."
}
