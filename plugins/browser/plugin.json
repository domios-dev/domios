{
  "id": "browser",
  "version": "1.16.0",
  "minCodeterm": "1.21.0",
  "hostApi": 2,
  "displayName": "Browser",
  "description": "An agent-owned live browser: the agent drives a real Chromium, the user watches it inside the agent's tab, joins in, and points at elements to ask the agent about them.",
  "entry": "plugin.js",
  "capabilities": {
    "surfaces": [
      {
        "id": "browser",
        "title": "Browser",
        "renderer": "stream",
        "runtime": "browser",
        "agentBound": true,
        "restore": "relaunch",
        "icon": "globe"
      }
    ],
    "graphNodes": {
      "steps": [
        {
          "contractVersion": 1,
          "revision": 1,
          "id": "browser.read_page",
          "title": "Browser: read page",
          "description": "Reads one page's text. Uses a temporary browser by default or a named profile allowed by the owner.",
          "params": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 2048,
                "description": "http(s) page to read; a bound url input wins."
              },
              "wait_text": {
                "type": "string",
                "maxLength": 256,
                "description": "Text to wait for before reading."
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2000,
                "default": 200,
                "description": "Lines of page text to keep."
              },
              "profile": {
                "type": "string",
                "maxLength": 40,
                "description": "An existing named Browser profile allowed by the owner. Omit for a temporary browser."
              }
            }
          },
          "inputs": {
            "url": {
              "kind": "text",
              "minItems": 0,
              "maxItems": 1
            }
          },
          "outputs": {
            "text": {
              "kind": "text",
              "minItems": 1,
              "maxItems": 1
            },
            "final_url": {
              "kind": "text",
              "minItems": 1,
              "maxItems": 1
            },
            "profile": {
              "kind": "text",
              "minItems": 1,
              "maxItems": 1
            },
            "capture_id": {
              "kind": "text",
              "minItems": 1,
              "maxItems": 1
            },
            "captured_at": {
              "kind": "text",
              "minItems": 1,
              "maxItems": 1
            }
          },
          "outcomes": [
            "read",
            "navigation_failed",
            "needs_human",
            "browser_busy",
            "profile_not_allowed",
            "origin_not_allowed"
          ],
          "lifecycle": {
            "reconcile": false,
            "cancel": false
          },
          "effects": {
            "sideEffects": false
          }
        },
        {
          "contractVersion": 1,
          "revision": 1,
          "id": "browser.snapshot_page",
          "title": "Browser: snapshot page",
          "description": "Captures one page's accessibility snapshot. Uses a temporary browser by default or a named profile allowed by the owner.",
          "params": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 2048,
                "description": "http(s) page to read; a bound url input wins."
              },
              "wait_text": {
                "type": "string",
                "maxLength": 256,
                "description": "Text to wait for before reading."
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 256,
                "default": 200,
                "description": "Maximum accessibility entries to capture."
              },
              "profile": {
                "type": "string",
                "maxLength": 40,
                "description": "An existing named Browser profile allowed by the owner. Omit for a temporary browser."
              }
            }
          },
          "inputs": {
            "url": {
              "kind": "text",
              "minItems": 0,
              "maxItems": 1
            }
          },
          "outputs": {
            "snapshot": {
              "kind": "json",
              "minItems": 1,
              "maxItems": 1,
              "schema": {
                "type": "object",
                "required": [
                  "items",
                  "truncated"
                ],
                "properties": {
                  "items": {
                    "type": "array",
                    "maxItems": 256,
                    "items": {
                      "type": "object",
                      "required": [
                        "role",
                        "name",
                        "depth"
                      ],
                      "properties": {
                        "role": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "depth": {
                          "type": "integer"
                        },
                        "href": {
                          "type": "string",
                          "maxLength": 2048
                        },
                        "value": {
                          "type": "string",
                          "maxLength": 60
                        }
                      }
                    }
                  },
                  "truncated": {
                    "type": "boolean"
                  },
                  "error": {
                    "type": "string"
                  }
                }
              }
            },
            "final_url": {
              "kind": "text",
              "minItems": 1,
              "maxItems": 1
            },
            "profile": {
              "kind": "text",
              "minItems": 1,
              "maxItems": 1
            },
            "capture_id": {
              "kind": "text",
              "minItems": 1,
              "maxItems": 1
            },
            "captured_at": {
              "kind": "text",
              "minItems": 1,
              "maxItems": 1
            }
          },
          "outcomes": [
            "read",
            "navigation_failed",
            "needs_human",
            "browser_busy",
            "profile_not_allowed",
            "origin_not_allowed"
          ],
          "lifecycle": {
            "reconcile": false,
            "cancel": false
          },
          "effects": {
            "sideEffects": false
          }
        }
      ]
    }
  },
  "permissions": {
    "agentCommands": true,
    "surfaces": true
  },
  "agentVerbs": [
    "help (any verb + --of <agent>: act in that agent's browser)",
    "open [url] [--profile NAME] | open --profile NAME --origin URL [--expect-build SHA] [--ephemeral]",
    "status",
    "profiles",
    "goto <url>",
    "back | forward | reload",
    "snapshot [limit] [--json] [--with-text] [--out FILE] [--scope SCOPE] [--actions-only] [--max-items N]",
    "click @ref | <name> | <role> <name> | --within role:name --role ROLE --name NAME",
    "type [--submit] @ref | <name> | <role> <name> <text> (or --stdin for masked secret input)",
    "press <key> [shift|ctrl|alt|meta]",
    "scroll <dy>",
    "text [limit] [--selector CSS] [--grep TEXT] [--out FILE]",
    "wait --text T | --url U | --selector S",
    "screenshot [file] [--full] [--viewport WIDTHxHEIGHT] [--mobile] [--dpr N] [--restore] [--metrics-json]",
    "inbox [all]",
    "annotate @ref | <role> <name> <comment> --of <agent> [--intent question|change|bug]",
    "endpoint",
    "close [--discard-unsaved]",
    "attach --profile NAME --origin URL [--expect-build SHA] [--ephemeral]",
    "connect --profile NAME --origin URL [--expect-build SHA] [--ephemeral] --stdin",
    "profile list | profile remove NAME",
    "viewport set WIDTH HEIGHT [--mobile] [--dpr N]",
    "fill <name> <text> | <role> <name> <text> | --within role:name --role ROLE --name NAME --text TEXT",
    "file-picker choose --paths PATH (unsupported; use Take control)",
    "upload <ref|button text> <pad-relative path>... (Windows; no native picker)",
    "wait --role ROLE --name NAME --state visible|hidden|enabled|expanded|checked|unchecked|pressed|unpressed|selected|unselected [--timeout DURATION]",
    "expand summary NAME",
    "collapse summary NAME",
    "open --domios-instance NAME --api-port PORT [--ephemeral]",
    "batch --from-pad FILE | --stdin ({name,input:{args}} steps; maximum 32; stops on error)",
    "hover | double-click | triple-click | right-click @ref | <role> <name>",
    "drag @from @to | x1 y1 x2 y2",
    "scroll-to @ref",
    "key <key> [shift|ctrl|alt|meta] [--repeat 1..100]",
    "form-value @ref <true|false|option value|option text>",
    "console [--pattern TEXT] [--limit 1..200]",
    "network [--limit 1..200]",
    "screenshot [file] [--region x,y,width,height] [--scale 0.1..4]",
    "snapshot [--ref @ref] [--depth 0..64]"
  ],
  "agentKeywords": [
    "browser",
    "web page",
    "website",
    "click",
    "screenshot",
    "accessibility snapshot",
    "test web ui",
    "form",
    "login"
  ],
  "agentGuide": "BROWSER.md",
  "agentPromptLine": "Browser: a real browser tab the user watches inside Domios — use it for any web page or UI testing task instead of Chrome extensions or other browser tools. How to use: `domios docs BROWSER`.",
  "hostIoJobs": true
}
