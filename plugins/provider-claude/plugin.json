{
  "id": "claude",
  "version": "1.12.1",
  "minCodeterm": "1.12.1",
  "hostApi": 2,
  "displayName": "Claude Code",
  "binaryName": "claude",
  "cliBinary": "claude",
  "iconColor": "#d97757",
  "entry": "plugin.js",
  "spawn": {
    "readinessStrategy": {
      "kind": "poll_shell_prompt",
      "timeoutSecs": 30
    },
    "taskDelivery": "inline_flag",
    "paste": {
      "untrustedAboveLines": 4,
      "typedFollowUp": " Handle the pasted message above as my request."
    },
    "systemPromptDelivery": {
      "kind": "cli_flag",
      "flag": "--append-system-prompt-file"
    },
    "verifySubmit": {
      "kind": "tui_input_drained",
      "initialKeyDelayMs": 100
    },
    "turnEvidenceNormalization": {
      "unwrapPastedContentWrapper": true,
      "collapseHorizontalWhitespace": true
    },
    "sessionIdInjection": "none",
    "statusBarRows": 3,
    "agentStateStatusReconciliation": true,
    "supportsLazySkills": true,
    "supportsDirectoryTrustPromptParsing": true,
    "hasHooks": true,
    "usageProbeCommand": "/usage",
    "launchPermissions": {
      "unattendedModeModels": [
        "opus",
        "sonnet",
        "fable"
      ],
      "commandRuleFormat": "Bash({command}:*)",
      "allowRuleArgsFormat": [
        "--allowedTools",
        "{rule}"
      ],
      "denyToolArgsFormat": [
        "--disallowedTools",
        "{tool}"
      ],
      "nativeSubagentTools": [
        "Agent",
        "Task"
      ]
    }
  },
  "sessions": {
    "rootDir": "~/.claude/projects",
    "cwdEncoding": "dash_encoded",
    "fileExtension": "jsonl"
  },
  "rule": {
    "path": "~/.claude/rules/codeterm.md"
  },
  "integration": {
    "kind": "claude_settings_json",
    "settingsPath": "~/.claude/settings.json"
  },
  "models": [
    {
      "id": "opus",
      "displayName": "Claude Opus",
      "description": "Best for everyday, complex tasks."
    },
    {
      "id": "sonnet",
      "displayName": "Claude Sonnet",
      "description": "Efficient for routine tasks."
    },
    {
      "id": "haiku",
      "displayName": "Claude Haiku",
      "description": "Fastest for quick answers."
    },
    {
      "id": "fable",
      "displayName": "Claude Fable",
      "description": "Most capable for your hardest and longest-running tasks."
    },
    {
      "id": "best",
      "displayName": "Claude Best",
      "description": "Claude Code's dynamic best-model alias."
    },
    {
      "id": "sonnet[1m]",
      "displayName": "Claude Sonnet (1M context)",
      "description": "Claude Code's Sonnet long-context alias."
    },
    {
      "id": "opus[1m]",
      "displayName": "Claude Opus (1M context)",
      "description": "Claude Code's Opus long-context alias."
    },
    {
      "id": "fable[1m]",
      "displayName": "Claude Fable (1M context)",
      "description": "Claude Code's Fable long-context alias."
    },
    {
      "id": "opusplan",
      "displayName": "Claude Opus Plan",
      "description": "Claude Code's Opus planning alias."
    }
  ],
  "defaultModel": "sonnet",
  "modelCatalogue": {
    "authority": "authoritative"
  },
  "reasoningEfforts": [
    {
      "id": "low",
      "displayName": "Low",
      "description": "Light reasoning for fast responses."
    },
    {
      "id": "medium",
      "displayName": "Medium",
      "description": "Balanced reasoning depth."
    },
    {
      "id": "high",
      "displayName": "High",
      "description": "Deeper reasoning for complex work."
    },
    {
      "id": "xhigh",
      "displayName": "Extra high",
      "description": "Extended reasoning for difficult work."
    },
    {
      "id": "max",
      "displayName": "Maximum",
      "description": "Maximum provider-supported reasoning depth."
    }
  ],
  "installer": {
    "macos": "curl -fsSL https://claude.ai/install.sh | bash",
    "linux": "curl -fsSL https://claude.ai/install.sh | bash",
    "windows": "$s = Join-Path $env:TEMP 'codeterm-claude-install.ps1'; Invoke-WebRequest -Uri 'https://claude.ai/install.ps1' -OutFile $s -UseBasicParsing; try { & $s } finally { Remove-Item $s -ErrorAction SilentlyContinue }"
  },
  "updater": {
    "macos": "claude update",
    "linux": "claude update",
    "windows": "claude update"
  },
  "commands": {
    "compact": "/compact",
    "freshContext": "/new",
    "exit": "/exit",
    "stopKey": "\u001b",
    "modelSwitch": "restart_resume",
    "autoApproveFlags": [
      "--dangerously-skip-permissions"
    ],
    "modelLaunchArgsFormat": [
      "--model",
      "{model}"
    ],
    "reasoningEffortLaunchArgsFormat": [
      "--effort",
      "{effort}"
    ]
  },
  "permissions": {
    "subprocess": {
      "allow": [
        "claude",
        "security"
      ]
    },
    "network": {
      "allow": [
        "api.anthropic.com"
      ]
    }
  },
  "icon": "icon.svg"
}
