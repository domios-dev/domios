{
  "id": "claude",
  "version": "1.14.25",
  "minCodeterm": "1.17.0",
  "hostApi": 2,
  "generalAgentOfferWhenAbsent": true,
  "displayName": "Claude Code",
  "binaryName": "claude",
  "cliBinary": "claude",
  "iconColor": "#d97757",
  "entry": "plugin.js",
  "spawn": {
    "forkSessionArgs": [
      "--fork-session"
    ],
    "capabilityProbe": "stream_json_initialize",
    "readinessStrategy": {
      "kind": "poll_shell_prompt",
      "timeoutSecs": 30
    },
    "taskDelivery": "inline_flag",
    "paste": {
      "untrustedAboveLines": 0,
      "typedFollowUp": "\npasted by Domios",
      "pasteMarkerWhen": "multiline",
      "marksRoutedMessages": true
    },
    "systemPromptDelivery": {
      "kind": "cli_flag",
      "flag": "--append-system-prompt-file"
    },
    "verifySubmit": {
      "kind": "tui_input_drained",
      "initialKeyDelayMs": 100
    },
    "turnEvidenceNormalization": {
      "unwrapPastedContentWrapper": true,
      "collapseHorizontalWhitespace": true
    },
    "sessionIdInjection": "none",
    "statusBarRows": 3,
    "agentStateStatusReconciliation": true,
    "supportsLazySkills": true,
    "supportsPromptAnswers": false,
    "supportsDirectoryTrustPromptParsing": true,
    "hasHooks": true,
    "usageProbeCommand": "/usage",
    "launchPermissions": {
      "unattendedModeModels": [
        "opus",
        "sonnet",
        "fable"
      ],
      "commandRuleFormat": "Bash({command}:*)",
      "allowRuleArgsFormat": [
        "--allowedTools",
        "{rule}"
      ],
      "denyToolArgsFormat": [
        "--disallowedTools",
        "{tool}"
      ],
      "nativeSubagentTools": [
        "Agent",
        "Task"
      ],
      "scopedFilesystem": {
        "noPromptArgs": [
          "--permission-mode",
          "dontAsk"
        ],
        "readAllRules": [
          "Read",
          "Glob",
          "Grep"
        ],
        "readRootRule": "Read({path}/**)",
        "writeRootRule": "Edit({path}/**)",
        "additionalDirectoryArgs": [
          "--add-dir",
          "{path}"
        ]
      }
    },
    "executionSandbox": {
      "unsupportedReason": "Permission modes and tool rules do not enforce read-only filesystem access for shell commands; use an enforcing provider or an explicit owner-run canonical gate."
    }
  },
  "sessions": {
    "rootDir": "~/.claude/projects",
    "cwdEncoding": "dash_encoded",
    "fileExtension": "jsonl",
    "rootEnvironment": {
      "variable": "CLAUDE_CONFIG_DIR",
      "subdir": "projects"
    }
  },
  "rule": {
    "path": "~/.claude/rules/codeterm.md"
  },
  "integration": {
    "kind": "claude_settings_json",
    "settingsPath": "~/.claude/settings.json"
  },
  "models": [
    {
      "id": "opus",
      "displayName": "Opus 5.5",
      "description": "Best for everyday, complex tasks.",
      "primary": true
    },
    {
      "id": "sonnet",
      "displayName": "Sonnet 5.5",
      "description": "Efficient for routine tasks.",
      "primary": true
    },
    {
      "id": "haiku",
      "displayName": "Haiku 5.5",
      "description": "Fastest for quick answers.",
      "primary": true
    },
    {
      "id": "fable",
      "displayName": "Fable 5.1",
      "description": "Most capable for your hardest and longest-running tasks.",
      "primary": true
    },
    {
      "id": "best",
      "displayName": "Claude Best",
      "description": "Claude Code's dynamic best-model alias.",
      "group": "Additional models"
    },
    {
      "id": "sonnet[1m]",
      "displayName": "Claude Sonnet (1M context)",
      "description": "Claude Code's Sonnet long-context alias.",
      "group": "Additional models"
    },
    {
      "id": "opus[1m]",
      "displayName": "Claude Opus (1M context)",
      "description": "Claude Code's Opus long-context alias.",
      "group": "Additional models"
    },
    {
      "id": "fable[1m]",
      "displayName": "Claude Fable (1M context)",
      "description": "Claude Code's Fable long-context alias.",
      "group": "Additional models"
    },
    {
      "id": "opusplan",
      "displayName": "Claude Opus Plan",
      "description": "Claude Code's Opus planning alias.",
      "group": "Additional models"
    }
  ],
  "defaultModel": "sonnet",
  "modelCatalogue": {
    "authority": "authoritative"
  },
  "reasoningEfforts": [
    {
      "id": "low",
      "displayName": "Low",
      "description": "Light reasoning for fast responses."
    },
    {
      "id": "medium",
      "displayName": "Medium",
      "description": "Balanced reasoning depth."
    },
    {
      "id": "high",
      "displayName": "High",
      "description": "Deeper reasoning for complex work."
    },
    {
      "id": "xhigh",
      "displayName": "Extra high",
      "description": "Extended reasoning for difficult work."
    },
    {
      "id": "max",
      "displayName": "Maximum",
      "description": "Maximum provider-supported reasoning depth."
    }
  ],
  "cliLogin": {
    "methods": [
      {
        "id": "subscription",
        "label": "Subscription",
        "args": [
          "auth",
          "login",
          "--claudeai"
        ]
      },
      {
        "id": "console",
        "label": "Console",
        "args": [
          "auth",
          "login",
          "--console"
        ]
      },
      {
        "id": "sso",
        "label": "SSO",
        "args": [
          "auth",
          "login",
          "--sso"
        ]
      }
    ],
    "urlPattern": "(https://(?:claude\\.ai|console\\.anthropic\\.com|platform\\.claude\\.com)/oauth/authorize\\?[^\\s\\x1b\\x07]+)[\\s\\x1b\\x07]",
    "timeoutMs": 900000,
    "codeInput": true
  },
  "installer": {
    "macos": "curl -fsSL https://claude.ai/install.sh | bash",
    "linux": "curl -fsSL https://claude.ai/install.sh | bash",
    "windows": "$s = Join-Path $env:TEMP 'codeterm-claude-install.ps1'; Invoke-WebRequest -Uri 'https://claude.ai/install.ps1' -OutFile $s -UseBasicParsing; try { & $s } finally { Remove-Item $s -ErrorAction SilentlyContinue }"
  },
  "updater": {
    "macos": "claude update",
    "linux": "claude update",
    "windows": "claude update"
  },
  "commands": {
    "compact": "/compact",
    "freshContext": "/new",
    "exit": "/exit",
    "idleRestartTermination": true,
    "stopKey": "\u001b",
    "modelSwitch": "live_command",
    "modelSwitchCommands": {
      "duringTurn": true,
      "readyInputRegex": "^\\s*❯\\s*$",
      "transcript": {
        "recordType": "user",
        "contentPath": [
          "message",
          "content"
        ],
        "prefix": "<local-command-stdout>",
        "suffix": "</local-command-stdout>",
        "ignoredContentRegexes": [
          "\\A<local-command-caveat>[^<>]*</local-command-caveat>\\z",
          "\\A<command-name>/model</command-name>\\s*<command-message>model</command-message>\\s*<command-args>\\s*</command-args>\\z",
          "\\A<command-name>/effort</command-name>\\s*<command-message>effort</command-message>\\s*<command-args>[^<>]*</command-args>\\z"
        ],
        "additionalRecordSources": [
          {
            "recordType": "system",
            "contentPath": [
              "content"
            ]
          }
        ]
      },
      "model": {
        "command": "/model",
        "confirmation": "(?i)^Set model to `?(?:{model}|{display_name})(?: [^`\\r\\n]+)?`? for this session only(?:$|[^a-z0-9_-])",
        "picker": {
          "screenRegex": "(?m)^\\s*Select model\\s*$[\\s\\S]*^\\s*Enter to set as default · s to use this session only · Esc to cancel[^\\S\\r\\n]*\\r?$",
          "selectedRegex": "(?m)^\\s*❯\\s*(?P<position>\\d+)\\.\\s+[^\\r\\n]+\\r?$",
          "targetRegex": "(?im)^\\s*(?:❯\\s*)?(?P<position>\\d+)\\.\\s+(?P<label>{display_name}|{model})(?:\\s*[✓✔])?(?:\\s+[^\\r\\n]+)?\\r?$",
          "position": "number",
          "previousKey": "\u001b[A",
          "nextKey": "\u001b[B",
          "responseKey": "s",
          "cancelKey": "\u001b"
        },
        "prompt": {
          "screenRegex": "(?im)^\\s*[^\\r\\n?]+\\?\\s*$[\\s\\S]*?^\\s*❯\\s*1\\.\\s+[^\\r\\n]*(?:{model}|{display_name})[^\\r\\n]*\\r?\\n\\s*2\\.\\s+[^\\r\\n]+\\s*^\\s*[─━-]{3,}[^\\r\\n]*\\r?$",
          "responseKeys": [
            "\r"
          ],
          "cancelKeys": [
            "\u001b"
          ]
        },
        "confirmationPromptKind": "switch_confirmation"
      },
      "effort": {
        "command": "/effort {effort}",
        "confirmation": "(?i)^Set effort level to {effort} \\(",
        "prompt": {
          "screenRegex": "(?im)^\\s*[^\\r\\n?]+\\?\\s*$[\\s\\S]*?^\\s*❯\\s*1\\.\\s+[^\\r\\n]*{effort}[^\\r\\n]*\\r?\\n\\s*2\\.\\s+[^\\r\\n]+\\s*^\\s*[─━-]{3,}[^\\r\\n]*\\r?$",
          "responseKeys": [
            "\r"
          ],
          "cancelKeys": [
            "\u001b"
          ]
        },
        "confirmationPromptKind": "switch_confirmation"
      }
    },
    "autoApproveFlags": [
      "--dangerously-skip-permissions"
    ],
    "modelLaunchArgsFormat": [
      "--model",
      "{model}"
    ],
    "reasoningEffortLaunchArgsFormat": [
      "--effort",
      "{effort}"
    ],
    "launchSpec": {
      "program": "claude",
      "args": [
        "{skipPermissions}",
        "{args}"
      ],
      "envUnset": [
        "CLAUDECODE"
      ]
    }
  },
  "permissions": {
    "subprocess": {
      "allow": [
        "claude",
        "security"
      ]
    },
    "network": {
      "allow": [
        "api.anthropic.com",
        "registry.npmjs.org"
      ]
    }
  },
  "icon": "icon.svg",
  "cliCompatibility": {
    "supported": [
      "=2.1.292"
    ],
    "breaking": [],
    "modelMinimumCli": {
      "fable": "2.1.258"
    }
  },
  "workerLaneSettings": [
    {
      "path": ".claude/settings.json",
      "patch": {
        "enabledPlugins": {
          "rust-analyzer-lsp@claude-plugins-official": false
        }
      }
    },
    {
      "path": ".claude/settings.local.json",
      "patch": {
        "enabledPlugins": {
          "rust-analyzer-lsp@claude-plugins-official": false
        }
      }
    }
  ],
  "capabilities": {
    "attachments": {
      "filePaths": true,
      "inlineText": true,
      "imagePaths": true
    },
    "agentProvider": true,
    "subagentVisibility": true,
    "recordSources": {
      "sessionTranscript": {
        "format": "jsonl",
        "filter": {}
      }
    }
  }
}
