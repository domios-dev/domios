{
  "id": "codex-fresh",
  "version": "0.1.0",
  "displayName": "Codex (fresh-plugin)",
  "binaryName": "codex",
  "cliBinary": "codex",
  "iconHint": "★",
  "iconColor": "#7aa2ff",
  "entry": "plugin.js",
  "spawn": {
    "readinessStrategy": { "kind": "poll_shell_prompt", "timeoutSecs": 30 },
    "taskDelivery": "pty_input",
    "taskInputWarmupMs": 3000,
    "verifySubmit": {
      "kind": "tui_input_drained",
      "timeoutSecs": 15,
      "idleAfterDrainMs": 800
    },
    "sessionIdInjection": "none",
    "statusBarRows": 1,
    "preservesContextOnResume": false,
    "supportsLazySkills": false,
    "hasHooks": false
  },
  "models": [
    { "id": "gpt-5.5", "displayName": "GPT-5.5", "description": "Frontier coding model." },
    { "id": "gpt-5.4-mini", "displayName": "GPT-5.4 Mini", "description": "Fast + cheap." }
  ],
  "defaultModel": "gpt-5.5",
  "installer": {
    "macos": "npm install -g @openai/codex",
    "linux": "npm install -g @openai/codex",
    "windows": "npm install -g @openai/codex"
  },
  "commands": {
    "exit": "/exit",
    "autoApproveFlags": ["--dangerously-bypass-approvals-and-sandbox"],
    "modelLaunchArgsFormat": ["-m", "{model}"]
  }
}
