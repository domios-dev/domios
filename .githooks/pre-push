#!/bin/bash
# Pre-push hook: cargo check before pushing to catch compile errors early
# Saves CI minutes by failing locally first

set -euo pipefail

# Lane branches get LIGHT checks only (shell guards + fmt): worker worktrees
# are cold — cargo check+clippy there is a multi-minute full build, and heavy
# verification is centralized at the integration/QA gate anyway.
# Full gate: protected integration branches, or PREPUSH_FULL=1.
# Light: lane/release-candidate branches, or PREPUSH_LIGHT=1.
PUSH_REFS="$(cat || true)"
light_refs_only=1
if [ -n "$PUSH_REFS" ]; then
    while read -r local_ref _local_sha remote_ref _remote_sha; do
        [ -z "$local_ref" ] && continue
        case "$local_ref:$remote_ref" in
            refs/heads/lane/*:*|refs/heads/release/*-candidate:*|*:refs/heads/lane/*|*:refs/heads/release/*-candidate) ;;
            *) light_refs_only=0 ;;
        esac
    done <<< "$PUSH_REFS"
else
    case "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)" in
        lane/*|release/*-candidate) ;;
        *) light_refs_only=0 ;;
    esac
fi
LIGHT=0
if [ "${PREPUSH_LIGHT:-0}" = "1" ]; then LIGHT=1; fi
if [ "$light_refs_only" = "1" ] && [ "${PREPUSH_FULL:-0}" != "1" ]; then LIGHT=1; fi

case "$(uname -s 2>/dev/null || echo unknown)" in
    MINGW*|MSYS*|CYGWIN*)
        if [ -z "${CARGO_TARGET_DIR:-}" ]; then
            tmp_root="${TMPDIR:-${TEMP:-/tmp}}"
            if command -v cygpath >/dev/null 2>&1; then
                tmp_root="$(cygpath -u "$tmp_root" 2>/dev/null || echo "$tmp_root")"
            fi
            export CARGO_TARGET_DIR="$tmp_root/codeterm-prepush-target"
        fi
        mkdir -p "$CARGO_TARGET_DIR"
        echo "Pre-push: using isolated Cargo target on Windows: $CARGO_TARGET_DIR"
        ;;
esac

if [ -f scripts/prepare-embed-stub.js ]; then
    node scripts/prepare-embed-stub.js >/dev/null
fi

echo "Pre-push: running shell guards..."
bash scripts/check-mux-write.sh
bash scripts/check-blocking-in-async.sh
bash scripts/check-visual-golden-edits.sh

# File-size discipline — pure line-count scan, no compile, runs on every push
# (lane + integration) so oversized files never reach the farm.
echo "Pre-push: checking file sizes..."
bash scripts/check-file-sizes.sh --fail

if [ "$LIGHT" = "1" ]; then
    echo "Pre-push: light branch — shell guards, file sizes, and fmt only; heavy gates run at the integration/QA gate."
    if ! cargo fmt --manifest-path src-tauri/Cargo.toml --all --check; then
        echo "❌ src-tauri cargo fmt --check failed — push aborted"
        exit 1
    fi
    if ! cargo fmt --manifest-path cli/Cargo.toml --all --check; then
        echo "❌ CLI cargo fmt --check failed — push aborted"
        exit 1
    fi
    echo "✅ light pre-push passed (PREPUSH_FULL=1 to force the full gate)"
    exit 0
fi

echo "Pre-push: running cargo check..."

# Main crate
if ! cargo check --manifest-path src-tauri/Cargo.toml 2>&1 | tail -5; then
    echo "❌ cargo check failed — push aborted"
    exit 1
fi

# CLI
if ! cargo check --manifest-path cli/Cargo.toml 2>&1 | tail -3; then
    echo "❌ CLI cargo check failed — push aborted"
    exit 1
fi

echo "✅ cargo check passed"


echo "Pre-push: running cargo fmt --check..."
if ! cargo fmt --manifest-path src-tauri/Cargo.toml --all --check; then
    echo "❌ src-tauri cargo fmt --check failed — push aborted"
    exit 1
fi
if ! cargo fmt --manifest-path cli/Cargo.toml --all --check; then
    echo "❌ CLI cargo fmt --check failed — push aborted"
    exit 1
fi

echo "Pre-push: running cargo clippy (scripts/clippy-gate.sh)..."
if ! bash scripts/clippy-gate.sh; then
    echo "❌ cargo clippy failed — push aborted"
    exit 1
fi

echo "✅ cargo fmt/clippy passed"
