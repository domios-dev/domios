{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rollacode/codeterm/docs/test-strategy/catalogue.schema.json",
  "title": "Domios test catalogue",
  "description": "tests/catalogue.json: one entry per runner, plus the stale and flaky overlay. Test membership is discovery output, never hand-listed here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runners", "overlay"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "runners": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/runner" }
    },
    "overlay": { "$ref": "#/$defs/overlay" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?!.*\\.\\.)[^\\s]+$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "task": {
      "type": "string",
      "pattern": "^task_[a-z0-9]+$"
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "lang",
        "runner",
        "discovery",
        "tier",
        "needs_instance",
        "needs_live_agent",
        "budget_secs",
        "owner_doc"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": ["unit", "integration", "e2e-plain", "e2e-curated", "eval", "contract", "guard"]
        },
        "lang": {
          "enum": ["rust", "ts", "js", "python", "bash", "mixed"]
        },
        "runner": {
          "description": "The exact command that runs every member, from the repository root.",
          "type": "string",
          "minLength": 1
        },
        "discovery": { "$ref": "#/$defs/discovery" },
        "tier": { "enum": ["pr", "release", "manual"] },
        "needs_instance": {
          "description": "Needs a running Domios instance (DEV 7686 or a named CODETERM_INSTANCE).",
          "type": "boolean"
        },
        "needs_live_agent": {
          "description": "Spawns a real provider agent and may spend provider tokens.",
          "type": "boolean"
        },
        "budget_secs": {
          "description": "Wall-clock budget for one full run of this runner on its CI or QA host.",
          "type": "integer",
          "minimum": 1
        },
        "owner_doc": {
          "description": "The skill, README or doc that owns how this runner is used.",
          "$ref": "#/$defs/repoPath"
        },
        "package": {
          "description": "Cargo package name, for Rust entries (D3: one entry per package).",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "manifest": {
          "description": "Cargo manifest path, for Rust entries.",
          "$ref": "#/$defs/repoPath"
        },
        "platforms": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": { "enum": ["linux", "macos", "windows"] }
        },
        "status": {
          "description": "suspended: kept and runnable on explicit request, selected by no tier gate.",
          "enum": ["active", "suspended"],
          "default": "active"
        },
        "ci": {
          "description": "Current CI placement as workflow:job (informative; ci-tiers wires tiers from the catalogue).",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+(\\.yml)?:[A-Za-z0-9_-]+$" }
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "lang": { "const": "rust" } } },
          "then": { "required": ["package", "manifest"] }
        },
        {
          "if": { "properties": { "needs_live_agent": { "const": true } } },
          "then": {
            "properties": {
              "tier": { "const": "manual" },
              "needs_instance": { "const": true }
            }
          }
        },
        {
          "if": {
            "properties": { "tier": { "const": "pr" } },
            "required": ["tier"]
          },
          "then": {
            "properties": {
              "needs_instance": { "const": false },
              "needs_live_agent": { "const": false },
              "budget_secs": { "type": "integer", "maximum": 480 }
            }
          }
        }
      ]
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {
          "description": "glob: files matching patterns; list-file: a JSON list owned elsewhere; nextest-list: cargo nextest list --message-format json; static-scan: scripts/rust-test-inventory.mjs; pytest-collect: pytest --collect-only; playwright-list: playwright test --list; script-catalog: scripts/check-script-catalog.sh entries; single: the runner is one check, not a set of tests.",
          "enum": [
            "glob",
            "list-file",
            "nextest-list",
            "static-scan",
            "pytest-collect",
            "playwright-list",
            "script-catalog",
            "single"
          ]
        },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "list_file": { "$ref": "#/$defs/repoPath" },
        "fallback": {
          "description": "Used where the primary method needs a compile that is not allowed (D3).",
          "enum": ["static-scan"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "method": { "const": "glob" } } },
          "then": { "required": ["patterns"] }
        },
        {
          "if": { "properties": { "method": { "const": "list-file" } } },
          "then": { "required": ["list_file"] }
        },
        {
          "if": { "properties": { "method": { "const": "nextest-list" } } },
          "then": { "required": ["fallback"] }
        }
      ]
    },
    "overlayTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["binary", "test"],
          "properties": {
            "binary": {
              "description": "nextest binary-id, e.g. codeterm (the src-tauri lib) or codeterm-plan.",
              "type": "string",
              "minLength": 1
            },
            "test": {
              "description": "Fully qualified test name, e.g. sentinel::tests::sentinel_probe_bounded_runtime_and_output.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["spec", "title"],
          "properties": {
            "spec": { "$ref": "#/$defs/repoPath" },
            "title": {
              "description": "Exact test title as Playwright reports it.",
              "type": "string",
              "minLength": 1
            },
            "step": {
              "description": "Names one silent sub-check inside the test when only that part is stale.",
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "overlaySource": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "commit": { "$ref": "#/$defs/sha" },
        "task": { "$ref": "#/$defs/task" }
      },
      "anyOf": [{ "required": ["commit"] }, { "required": ["task"] }]
    },
    "overlayMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "target", "reason", "source"],
      "properties": {
        "runner": {
          "description": "The catalogue runner id this marker belongs to.",
          "$ref": "#/$defs/id"
        },
        "target": { "$ref": "#/$defs/overlayTarget" },
        "reason": { "type": "string", "minLength": 10 },
        "source": {
          "description": "The commit that made it stale, or the task that recorded it.",
          "$ref": "#/$defs/overlaySource"
        },
        "fix_task": { "$ref": "#/$defs/task" }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stale", "flaky"],
      "properties": {
        "stale": {
          "type": "array",
          "items": { "$ref": "#/$defs/overlayMarker" }
        },
        "flaky": {
          "type": "array",
          "items": { "$ref": "#/$defs/overlayMarker" }
        }
      }
    }
  }
}
