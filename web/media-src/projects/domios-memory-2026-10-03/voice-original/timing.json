  "cues": [
    {
      "id": 1,
      "text": "Meet Domios. A home for your AI agents.",
      "start": 0.65,
      "end": 3.657,
      "visualStart": 0,
      "visualEnd": 3.8333333333333335
    },
    {
      "id": 2,
      "text": "Open a tab, choose an agent, and get to work.",
      "start": 3.9819999999999998,
      "end": 6.885000000000001,
      "visualStart": 3.8333333333333335,
      "visualEnd": 7.2
    },
    {
      "id": 3,
      "text": "Give your next task its own team.",
      "start": 7.488,
      "end": 9.404,
      "visualStart": 7.2,
      "visualEnd": 9.633333333333333
    },
    {
      "id": 4,
      "text": "Then follow the work across the board, through to a result.",
      "start": 9.845,
      "end": 13.409,
      "visualStart": 9.633333333333333,
      "visualEnd": 13.633333333333333
    },
    {
      "id": 5,
      "text": "Your own computers, connected in one trusted mesh.",
      "start": 13.851,
      "end": 16.881,
      "visualStart": 13.633333333333333,
      "visualEnd": 17.166666666666668
    },
    {
      "id": 6,
      "text": "Reach a workspace on another machine.",
      "start": 17.483999999999998,
      "end": 19.493,
      "visualStart": 17.166666666666668,
      "visualEnd": 19.9
    },
    {
      "id": 7,
      "text": "Ask an agent to check in with its peers.",
      "start": 20.305999999999997,
      "end": 22.593,
      "visualStart": 19.9,
      "visualEnd": 22.8
    },
    {
      "id": 8,
      "text": "And bring their reports back here.",
      "start": 23.034,
      "end": 24.775,
      "visualStart": 22.8,
      "visualEnd": 25.133333333333333
    },
    {
      "id": 9,
      "text": "Choose the intelligence that fits your work.",
      "start": 25.471999999999998,
      "end": 27.793999999999997,
      "visualStart": 25.133333333333333,
      "visualEnd": 28.033333333333335
    },
    {
      "id": 10,
      "text": "Bring your tools along, too.",
      "start": 28.305,
      "end": 29.884,
      "visualStart": 28.033333333333335,
      "visualEnd": 30.3
    },
    {
      "id": 11,
      "text": "Add more capabilities through plugins.",
      "start": 30.697,
      "end": 32.983,
      "visualStart": 30.3,
      "visualEnd": 33.333333333333336
    },
    {
      "id": 12,
      "text": "See your fleet, including who is offline.",
      "start": 33.68,
      "end": 36.861,
      "visualStart": 33.333333333333336,
      "visualEnd": 37.06666666666667
    },
    {
      "id": 13,
      "text": "Your next idea. A whole team behind it. Domios.",
      "start": 37.302,
      "end": 42.678,
      "visualStart": 37.06666666666667,
      "visualEnd": 45.0
    }
  ],
