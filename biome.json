{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.js",
      "**/*.jsx",
      "**/*.ts",
      "**/*.tsx",
      "!cli/**",
      "!crates/**",
      "!dist/**",
      "!evals/**",
      "!node_modules/**",
      "!plugins/git/ui/**",
      "!refs/**",
      "!tests/playwright/**",
      "!src-tauri/**"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false
    }
  },
  "assist": {
    "enabled": false
  }
}
