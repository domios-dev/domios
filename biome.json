{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.js",
      "**/*.jsx",
      "**/*.ts",
      "**/*.tsx",
      "!cli/**",
      "!crates/**",
      "!dist/**",
      "!evals/**",
      "!node_modules/**",
      "!refs/**",
      "!tests/playwright/**",
      "!src-tauri/**"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none"
    }
  },
  "assist": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": [
        "src/**",
        "!src/**/*.test.*",
        "!src/**/*.testdata.*"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "Use TransportClient through webApi or daemonBootstrap; raw fetch is reserved for carrier control and the HttpOnly manifest bootstrap."
                }
              }
            }
          },
          "nursery": {
            "noJsRestrictedProperties": {
              "level": "error",
              "options": {
                "entries": [
                  {
                    "object": "window",
                    "property": "fetch",
                    "message": "Use TransportClient; raw fetch is reserved for carrier control and manifest cookie bootstrap."
                  },
                  {
                    "object": "globalThis",
                    "property": "fetch",
                    "message": "Use TransportClient; raw fetch is reserved for carrier control and manifest cookie bootstrap."
                  },
                  {
                    "object": "self",
                    "property": "fetch",
                    "message": "Use TransportClient; raw fetch is reserved for carrier control and manifest cookie bootstrap."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
